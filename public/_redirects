# Shopify paths that have no equivalent on the static site.
# Product and page URLs are unchanged, so they need no redirect.

# The exact-match 200 must come first: Cloudflare Pages applies redirects before
# static assets, so a bare /collections/* splat would redirect /collections/all
# to itself forever — taking out the page the whole nav points at.
/collections/all          /collections/all  200
/collections              /collections/all  301
/collections/*            /collections/all  301

# Shopify checkout paths. Safe to bounce home: the buy buttons now point at
# tangogarden.myshopify.com, so nothing on this site relies on them.
/cart                     /                 301
/cart/*                   /                 301
/checkout                 /                 301
/account                  /                 301
/account/*                /                 301
/search                   /                 301
/apps/*                   /                 301

# Enter the Garden is now a single free open-air event. The old Student/Under-28
# tier was retired and permanently redirects to the general page.
/products/enter-the-garden-introductory-session-student-and-under-28-admission  /products/enter-the-garden-general-admission  301

# Start Here was consolidated into The Garden (its "Is This For You" content
# now lives at /pages/the-garden#is-this-for-you; the pathway cards it hosted
# are on the homepage and /collections/all).
/pages/start-here        /pages/the-garden  301

