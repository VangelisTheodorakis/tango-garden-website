---
/**
 * Gardeners' Area: private registration dashboard.
 *
 * Cloudflare Access guards /gardeners-area (Google login, allowed emails only).
 * The numbers come from /gardeners-area/api/report, the tango-garden-gardeners
 * Worker (workers/gardeners-api), which reads GA4. No analytics on this page,
 * not indexed, not in the sitemap. On localhost there is no API, so the page
 * shows clearly marked demo numbers for layout work.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Gardeners' Area | Tango Garden"
  description="Private registration dashboard for the Tango Garden team."
  canonical="https://tangogarden.de/gardeners-area"
  noindex
  analytics={false}
>
  <div class="gd">
    <header class="gd-head">
      <div>
        <h1>Gardeners' Area</h1>
        <p class="gd-sub">How people find the courses and sign up.</p>
      </div>
      <div class="gd-periods" role="group" aria-label="Period">
        <button type="button" data-days="7" aria-pressed="false">7 days</button>
        <button type="button" data-days="28" aria-pressed="true">28 days</button>
        <button type="button" data-days="90" aria-pressed="false">90 days</button>
      </div>
    </header>

    <p class="gd-status" id="gd-status" role="status">Loading the numbers…</p>

    <section class="gd-section" aria-labelledby="gd-site-h">
      <h2 id="gd-site-h">The website</h2>
      <div class="gd-tiles">
        <div class="gd-tile">
          <span class="gd-tile-label">Visits</span>
          <span class="gd-tile-value" id="gd-visits">–</span>
          <span class="gd-tile-note">each time someone opens the site, on any page; a person who comes back tomorrow counts twice</span>
        </div>
        <div class="gd-tile">
          <span class="gd-tile-label">Bounce rate</span>
          <span class="gd-tile-value" id="gd-bounce">–</span>
          <span class="gd-tile-note">share of visits that left within 10 seconds, without clicking anything or opening a second page</span>
        </div>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="gd-reg-h">
      <h2 id="gd-reg-h">This round's sign-ups</h2>
      <p class="gd-note">From the form response sheets, one per person. Delete a test or a cancellation in the sheet and it disappears here.</p>
      <div class="gd-pair" id="gd-reg"></div>
    </section>

    <section class="gd-section" aria-labelledby="gd-funnel-h">
      <h2 id="gd-funnel-h">From course page to sign-up</h2>
      <p class="gd-note">Counts per step, not individual people. Each bar is compared with the course page visits.</p>
      <div class="gd-funnels" id="gd-funnels"></div>
      <p class="gd-note" id="gd-unassigned" hidden></p>
    </section>

    <section class="gd-section" aria-labelledby="gd-read-h">
      <h2 id="gd-read-h">How far people read</h2>
      <p class="gd-note">Share of course page visits that scrolled to each part of the page. Counted since November 2026, so longer periods start low.</p>
      <div class="gd-pair" id="gd-read"></div>
    </section>

    <section class="gd-section" aria-labelledby="gd-ask-h">
      <h2 id="gd-ask-h">What people want to know</h2>
      <p class="gd-note">The questions people open before deciding, and where they message you instead of registering.</p>
      <div class="gd-pair">
        <div class="gd-card">
          <h3>FAQ questions opened</h3>
          <ol class="gd-list" id="gd-faq"></ol>
        </div>
        <div class="gd-card">
          <h3>WhatsApp clicks <span class="gd-card-total" id="gd-wa-total"></span></h3>
          <ol class="gd-list" id="gd-wa"></ol>
        </div>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="gd-trend-h">
      <h2 id="gd-trend-h">Week by week</h2>
      <p class="gd-note">Last 12 weeks, both courses together.</p>
      <div class="gd-legend" aria-hidden="true">
        <span><i class="gd-swatch gd-s1"></i>Register clicks</span>
        <span><i class="gd-swatch gd-s2"></i>Forms submitted</span>
      </div>
      <div class="gd-chart" id="gd-trend"></div>
    </section>

    <section class="gd-section" aria-labelledby="gd-sources-h">
      <h2 id="gd-sources-h">Where visitors come from</h2>
      <p class="gd-note">Visits and bounce rate as explained at the top; clicks are register clicks. Forms submitted can't be traced back to a source, so this stops at the register click. Click a column to sort.</p>
      <div class="gd-table-wrap">
        <table class="gd-table" data-table="sources">
          <thead>
            <tr>
              <th scope="col"><button type="button" class="gd-sort" data-sort="channel">Source</button></th>
              <th scope="col" aria-sort="descending"><button type="button" class="gd-sort" data-sort="sessions">Visits</button></th>
              <th scope="col"><button type="button" class="gd-sort" data-sort="bounceRate">Bounce</button></th>
              <th scope="col"><button type="button" class="gd-sort" data-sort="clicks">Clicks</button></th>
            </tr>
          </thead>
          <tbody id="gd-sources"></tbody>
        </table>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="gd-search-h">
      <h2 id="gd-search-h">What people searched for</h2>
      <p class="gd-note">Google searches that showed the site, from Search Console. Shown: how often the site appeared in the results; clicks: how often someone clicked through; position: average place in the results (1 is the top). Google leaves out rare searches and reports about two days late. Click a column to sort.</p>
      <div class="gd-table-wrap">
        <table class="gd-table" data-table="search">
          <thead>
            <tr>
              <th scope="col"><button type="button" class="gd-sort" data-sort="query">Search</button></th>
              <th scope="col"><button type="button" class="gd-sort" data-sort="impressions">Shown</button></th>
              <th scope="col" aria-sort="descending"><button type="button" class="gd-sort" data-sort="clicks">Clicks</button></th>
              <th scope="col"><button type="button" class="gd-sort" data-sort="position">Position</button></th>
            </tr>
          </thead>
          <tbody id="gd-search"></tbody>
        </table>
      </div>
    </section>

    <p class="gd-foot" id="gd-updated"></p>
  </div>
</BaseLayout>

<style is:global>
  .gd {
    --gd-s1: #4f7a1f; /* register clicks: validated pair, see dataviz check */
    --gd-s2: #3a6bc4; /* forms submitted */
    --gd-track: rgba(78, 93, 34, 0.08);
    --gd-grid: rgba(37, 37, 37, 0.1);
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 16px 64px;
    color: var(--text);
  }
  .gd-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .gd h1 {
    font-size: 2rem;
    color: var(--green);
    margin: 0;
  }
  .gd-sub {
    color: var(--text-light);
    margin: 4px 0 0;
  }
  .gd-periods {
    display: inline-flex;
    background: var(--cream-light);
    border: 1px solid rgba(78, 93, 34, 0.15);
    border-radius: 999px;
    padding: 3px;
  }
  .gd-periods button {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--green);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
  }
  .gd-periods button[aria-pressed='true'] {
    background: var(--green);
    color: #fff;
  }
  .gd-status {
    font-size: 0.9rem;
    color: var(--text-light);
    margin: 0 0 8px;
  }
  .gd-status.is-demo {
    background: #fff4d6;
    color: #6b4e00;
    border-radius: 8px;
    padding: 10px 14px;
  }
  .gd-status.is-error {
    background: #fde8e8;
    color: #8a1c1c;
    border-radius: 8px;
    padding: 10px 14px;
  }
  .gd-section {
    margin-top: 36px;
  }
  .gd h2 {
    font-size: 1.2rem;
    color: var(--green);
    margin: 0 0 4px;
  }
  .gd-note {
    font-size: 0.85rem;
    color: var(--text-light);
    margin: 0 0 14px;
  }
  .gd-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }
  .gd-tile {
    background: var(--cream-light);
    border-radius: var(--radius);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .gd-tile-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-light);
  }
  .gd-tile-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .gd-tile-note {
    font-size: 0.75rem;
    color: var(--text-light);
  }
  .gd-funnels {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 720px) {
    .gd-funnels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .gd-funnel {
    background: var(--cream-light);
    border-radius: var(--radius);
    padding: 18px 16px;
  }
  .gd-funnel h3 {
    font-size: 1rem;
    margin: 0 0 12px;
  }
  .gd-step + .gd-step {
    margin-top: 12px;
  }
  .gd-step-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.85rem;
  }
  .gd-step-value {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .gd-step-rate {
    color: var(--text-light);
    font-weight: 500;
  }
  .gd-bar {
    margin-top: 4px;
    height: 12px;
    background: var(--gd-track);
    border-radius: 4px;
    overflow: hidden;
  }
  .gd-bar > span {
    display: block;
    height: 100%;
    min-width: 2px;
    background: var(--gd-s1);
    border-radius: 0 4px 4px 0;
  }
  .gd-lang {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--gd-grid);
    font-size: 0.8rem;
    color: var(--text-mid);
    display: grid;
    gap: 2px;
  }
  .gd-lang b {
    color: var(--text);
    font-weight: 600;
  }
  .gd-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 720px) {
    .gd-pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .gd-card {
    background: var(--cream-light);
    border-radius: var(--radius);
    padding: 18px 16px;
  }
  .gd-card h3 {
    font-size: 1rem;
    margin: 0 0 12px;
  }
  .gd-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
  }
  .gd-since {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--green);
    background: rgba(78, 93, 34, 0.1);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .gd-card-total {
    font-weight: 500;
    color: var(--text-light);
  }
  .gd-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .gd-list li {
    font-size: 0.85rem;
  }
  .gd-list .gd-step-top span:first-child {
    overflow-wrap: anywhere;
  }
  .gd-spots {
    font-size: 2rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .gd-spots small {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-light);
  }
  .gd-card .gd-bar {
    margin-bottom: 14px;
  }
  .gd-card .gd-list .gd-bar {
    margin-bottom: 0;
  }
  .gd-roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0 0 12px;
  }
  .gd-roles div {
    background: #fff;
    border-radius: 8px;
    padding: 8px 10px;
  }
  .gd-roles dt {
    font-size: 0.75rem;
    color: var(--text-light);
    font-weight: 600;
  }
  .gd-roles dd {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .gd-card-note {
    font-size: 0.8rem;
    color: var(--text-mid);
    margin: 0;
  }
  .gd-empty {
    color: var(--text-light);
  }
  .gd-legend {
    display: flex;
    gap: 16px;
    font-size: 0.8rem;
    color: var(--text-mid);
    margin-bottom: 8px;
  }
  .gd-swatch {
    display: inline-block;
    width: 12px;
    height: 3px;
    border-radius: 2px;
    vertical-align: middle;
    margin-right: 6px;
  }
  .gd-s1 {
    background: var(--gd-s1);
  }
  .gd-s2 {
    background: var(--gd-s2);
  }
  .gd-chart {
    position: relative;
  }
  .gd-chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .gd-chart text {
    font-size: 11px;
    fill: var(--text-light);
    font-family: var(--font);
  }
  .gd-tip {
    position: absolute;
    top: 0;
    pointer-events: none;
    background: #fff;
    border: 1px solid var(--gd-grid);
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    padding: 8px 10px;
    font-size: 0.8rem;
    white-space: nowrap;
    transform: translateX(-50%);
  }
  .gd-tip b {
    display: block;
    margin-bottom: 2px;
  }
  .gd-table-wrap {
    overflow-x: auto;
  }
  .gd-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .gd-table th {
    text-align: right;
    font-size: 0.75rem;
    color: var(--text-light);
    font-weight: 600;
    padding: 6px 8px;
    border-bottom: 1px solid var(--gd-grid);
  }
  .gd-sort {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    white-space: nowrap;
  }
  .gd-sort::after {
    content: '↕';
    margin-left: 4px;
    opacity: 0.35;
  }
  [aria-sort='ascending'] > .gd-sort::after {
    content: '↑';
    opacity: 1;
  }
  [aria-sort='descending'] > .gd-sort::after {
    content: '↓';
    opacity: 1;
  }
  .gd-sort:hover,
  [aria-sort] > .gd-sort {
    color: var(--green);
  }
  .gd-table td + td {
    white-space: nowrap;
  }
  .gd-table th:first-child,
  .gd-table td:first-child {
    text-align: left;
    padding-left: 0;
  }
  .gd-table td {
    text-align: right;
    padding: 8px;
    border-bottom: 1px solid var(--gd-grid);
  }
  .gd-cellbar {
    display: inline-block;
    height: 8px;
    min-width: 2px;
    background: var(--gd-s1);
    border-radius: 0 3px 3px 0;
    margin-right: 6px;
    vertical-align: middle;
    opacity: 0.55;
  }
  .gd-foot {
    margin-top: 32px;
    font-size: 0.8rem;
    color: var(--text-light);
  }
</style>

<script>
  type LangCounts = { pageSessions: number; clicks: number };
  type Course = {
    slug: string;
    label: string;
    pageSessions: number;
    clicks: number;
    submits: number;
    lang: { en: LangCounts; de: LangCounts };
    read?: Record<string, number>;
  };
  type Round = {
    from: string;
    spots: number;
    registered: number;
    roles: { leader: number; follower: number; both: number; unknown: number };
    returning: number;
  };
  type Report = {
    days: number;
    generatedAt: string;
    site: { sessions: number; bounceRate: number };
    courses: Course[];
    unassigned: { clicks: number; submits: number };
    channels: { channel: string; sessions: number; bounceRate: number; clicks: number }[];
    weeks: { week: string; clicks: number; submits: number }[];
    faq: { question: string; count: number }[];
    whatsapp: { total: number; pages: { path: string; count: number }[] };
    search?: { query: string; clicks: number; impressions: number; position: number }[] | null;
    registrations?: Record<string, Round | null> | null;
  };

  const SECTIONS = [
    { key: 'expect', label: 'What to expect' },
    { key: 'prices', label: 'Prices' },
    { key: 'faq', label: 'Questions' },
    { key: 'end', label: 'End of the page' },
  ];
  const dateLabel = (iso: string) =>
    new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

  const PAGE_NAMES: Record<string, string> = {
    '/': 'Homepage',
    '/pages/contact': 'Contact',
    '/pages/classes': 'Classes',
    '/pages/the-garden': 'The Garden',
    '/pages/enter-the-garden': 'Enter the Garden',
    '/pages/beginner-course': 'Beginners course',
    '/pages/growth-sessions': 'Improvers course',
    '/pages/garden-practica': 'Practica',
    '/pages/private-classes': 'Private classes',
  };
  /** "/de/pages/contact" -> "Contact (German)"; unknown paths stay as they are. */
  function pageName(path: string) {
    const de = /^\/de(\/|$)/.test(path);
    const en = (de ? path.slice(3) : path).replace(/\/$/, '') || '/';
    const name = PAGE_NAMES[en] ?? path;
    return de ? `${name} (German)` : name;
  }

  const LOCAL = ['localhost', '127.0.0.1'].includes(location.hostname);
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (n: number) => n.toLocaleString('en-GB');
  const pct = (n: number) => `${Math.round(n * 100)}%`;
  const plural = (n: number, word: string) => `${fmt(n)} ${word}${n === 1 ? '' : 's'}`;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };

  /** Monday of an ISO week key "202645", as "3 Nov". */
  function weekLabel(key: string) {
    const year = Number(key.slice(0, 4));
    const week = Number(key.slice(4));
    const jan4 = new Date(Date.UTC(year, 0, 4));
    const monday = new Date(jan4.getTime() - ((jan4.getUTCDay() || 7) - 1) * 86400000 + (week - 1) * 7 * 86400000);
    return monday.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  }

  function renderFunnels(courses: Course[], unassigned: Report['unassigned']) {
    const box = $('gd-funnels');
    box.textContent = '';
    for (const c of courses) {
      const card = el('div', 'gd-funnel');
      card.append(el('h3', '', c.label));
      const steps = [
        { label: 'Course page visits', value: c.pageSessions, prev: null as number | null },
        { label: 'Register clicks', value: c.clicks, prev: c.pageSessions },
        { label: 'Forms submitted', value: c.submits, prev: c.clicks },
      ];
      const base = Math.max(c.pageSessions, c.clicks, c.submits, 1);
      for (const s of steps) {
        const step = el('div', 'gd-step');
        const top = el('div', 'gd-step-top');
        top.append(el('span', '', s.label));
        const val = el('span', 'gd-step-value', fmt(s.value));
        if (s.prev !== null) val.append(el('span', 'gd-step-rate', s.prev > 0 ? ` · ${pct(s.value / s.prev)} of previous` : ' · –'));
        top.append(val);
        const bar = el('div', 'gd-bar');
        const fill = el('span');
        fill.style.width = `${(s.value / base) * 100}%`;
        bar.title = `${s.label}: ${fmt(s.value)}`;
        bar.append(fill);
        step.append(top, bar);
        card.append(step);
      }
      const lang = el('div', 'gd-lang');
      for (const [code, name] of [['en', 'English'], ['de', 'German']] as const) {
        const l = c.lang?.[code];
        if (!l) continue;
        const rate = l.pageSessions > 0 ? ` (${pct(l.clicks / l.pageSessions)})` : '';
        const line = el('div');
        line.append(el('b', '', `${name} page: `), document.createTextNode(`${plural(l.pageSessions, 'visit')} → ${plural(l.clicks, 'click')}${rate}`));
        lang.append(line);
      }
      card.append(lang);
      box.append(card);
    }
    const note = $('gd-unassigned');
    const total = unassigned.clicks + unassigned.submits;
    note.hidden = total === 0;
    note.textContent = total
      ? `Not counted above: ${plural(unassigned.clicks, 'click')} and ${plural(unassigned.submits, 'submission')} without a known course (mostly tests).`
      : '';
  }

  /**
   * Sortable tables: a click on a header sorts by that column, a second click
   * reverses it. Text starts A→Z, numbers largest first, except Position,
   * where 1 is the best.
   */
  type SortState = { key: string; dir: 1 | -1 };
  const sorting: Record<string, SortState> = {
    sources: { key: 'sessions', dir: -1 },
    search: { key: 'clicks', dir: -1 },
  };
  function sorted<T extends Record<string, unknown>>(table: string, rows: T[]): T[] {
    const { key, dir } = sorting[table];
    return [...rows].sort((a, b) => {
      const x = a[key], y = b[key];
      return (typeof x === 'string' ? x.localeCompare(String(y)) : Number(x) - Number(y)) * dir;
    });
  }
  document.querySelectorAll<HTMLTableElement>('table[data-table]').forEach((table) => {
    const name = table.dataset.table!;
    table.querySelectorAll<HTMLButtonElement>('.gd-sort').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort!;
        const state = sorting[name];
        const textColumn = key === 'channel' || key === 'query';
        if (state.key === key) state.dir = state.dir === 1 ? -1 : 1;
        else sorting[name] = { key, dir: textColumn || key === 'position' ? 1 : -1 };
        table.querySelectorAll('th').forEach((th) => th.removeAttribute('aria-sort'));
        btn.parentElement!.setAttribute('aria-sort', sorting[name].dir === 1 ? 'ascending' : 'descending');
        if (!last) return;
        if (name === 'sources') renderSources(last.channels);
        else renderSearch(last.search ?? null);
      });
    });
  });

  function renderSources(channels: Report['channels']) {
    const body = $('gd-sources');
    body.textContent = '';
    const max = Math.max(1, ...channels.map((c) => c.sessions));
    for (const c of sorted('sources', channels)) {
      const tr = el('tr');
      tr.append(el('td', '', c.channel));
      const visits = el('td');
      const bar = el('span', 'gd-cellbar');
      bar.style.width = `${Math.round((c.sessions / max) * 40)}px`;
      visits.append(bar, document.createTextNode(fmt(c.sessions)));
      tr.append(visits, el('td', '', pct(c.bounceRate)), el('td', '', fmt(c.clicks)));
      body.append(tr);
    }
    if (!channels.length) {
      const tr = el('tr');
      const td = el('td', '', 'No visits in this period.');
      td.colSpan = 4;
      tr.append(td);
      body.append(tr);
    }
  }

  /** A ranked list with a bar per row, longest bar = the top row. */
  function renderList(id: string, rows: { label: string; count: number; value?: string; max?: number }[], empty: string) {
    const list = $(id);
    list.textContent = '';
    if (!rows.length) {
      list.append(el('li', 'gd-empty', empty));
      return;
    }
    const max = Math.max(1, ...rows.map((r) => r.max ?? r.count));
    for (const r of rows) {
      const li = el('li');
      const top = el('div', 'gd-step-top');
      top.append(el('span', '', r.label), el('span', 'gd-step-value', r.value ?? fmt(r.count)));
      const bar = el('div', 'gd-bar');
      const fill = el('span');
      fill.style.width = `${Math.min(100, (r.count / max) * 100)}%`;
      bar.append(fill);
      li.append(top, bar);
      list.append(li);
    }
  }

  function renderRegistrations(courses: Course[], regs: Report['registrations']) {
    const box = $('gd-reg');
    box.textContent = '';
    if (!regs) {
      box.append(el('p', 'gd-note', 'Not connected yet: the response sheets need to be shared with the data service (setup guide, step 6).'));
      return;
    }
    for (const c of courses) {
      const r = regs[c.slug];
      const card = el('div', 'gd-card');
      const title = el('h3', 'gd-card-head', c.label);
      if (r) title.append(el('span', 'gd-since', `Counting from ${dateLabel(r.from)}`));
      card.append(title);
      if (!r) {
        card.append(el('p', 'gd-card-note', 'No response sheet set for this course yet.'));
        box.append(card);
        continue;
      }
      const spots = el('div', 'gd-spots', fmt(r.registered));
      spots.append(el('small', '', ` of ${fmt(r.spots)} spots`));
      const bar = el('div', 'gd-bar');
      const fill = el('span');
      fill.style.width = `${Math.min(100, (r.registered / Math.max(1, r.spots)) * 100)}%`;
      bar.title = `${fmt(r.registered)} of ${fmt(r.spots)} spots`;
      bar.append(fill);
      const roles = el('dl', 'gd-roles');
      for (const [label, n] of [['Leaders', r.roles.leader], ['Followers', r.roles.follower], ['Both roles', r.roles.both]] as const) {
        const d = el('div');
        d.append(el('dt', '', label), el('dd', '', fmt(n)));
        roles.append(d);
      }
      const isNew = r.registered - r.returning;
      const parts = [`${plural(r.returning, 'returning student')}, ${fmt(isNew)} new`];
      if (r.roles.unknown) parts.push(`${fmt(r.roles.unknown)} without a role`);
      card.append(spots, bar, roles, el('p', 'gd-card-note', `${parts.join(' · ')}.`));
      box.append(card);
    }
  }

  function renderReading(courses: Course[]) {
    const box = $('gd-read');
    box.textContent = '';
    for (const c of courses) {
      const card = el('div', 'gd-card');
      card.append(el('h3', '', c.label));
      const list = el('ol', 'gd-list');
      list.id = `gd-read-${c.slug}`;
      card.append(list);
      box.append(card);
      const visits = c.pageSessions;
      const rows = [
        { label: 'Course page visits', count: visits, value: fmt(visits), max: visits },
        ...SECTIONS.map((s) => {
          const n = c.read?.[s.key] ?? 0;
          return { label: s.label, count: n, value: visits > 0 ? `${fmt(n)} · ${pct(n / visits)}` : fmt(n), max: visits };
        }),
      ];
      renderList(list.id, rows, '');
    }
  }

  function renderSearch(search: Report['search']) {
    const body = $('gd-search');
    body.textContent = '';
    const message = !search ? 'Not connected yet: Search Console needs to give the data service access (setup guide, step 7).' : !search.length ? 'No searches in this period.' : '';
    if (message) {
      const tr = el('tr');
      const td = el('td', '', message);
      td.colSpan = 4;
      tr.append(td);
      body.append(tr);
      return;
    }
    for (const q of sorted('search', search!)) {
      const tr = el('tr');
      tr.append(el('td', '', q.query), el('td', '', fmt(q.impressions)), el('td', '', fmt(q.clicks)), el('td', '', q.position.toFixed(1)));
      body.append(tr);
    }
  }

  const SVG = 'http://www.w3.org/2000/svg';
  const svgEl = (tag: string, attrs: Record<string, string | number>) => {
    const e = document.createElementNS(SVG, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    return e;
  };

  function renderTrend(weeks: Report['weeks']) {
    const box = $('gd-trend');
    box.textContent = '';
    // Drawn at the box's real width, so the 11px labels stay 11px on a phone.
    const W = Math.max(280, box.clientWidth), H = 220, L = 28, R = 12, T = 12, B = 26;
    const labelEvery = W < 480 ? 3 : 2;
    const max = Math.max(4, ...weeks.flatMap((w) => [w.clicks, w.submits]));
    const step = Math.ceil(max / 4);
    const top = step * 4;
    const x = (i: number) => L + (i * (W - L - R)) / Math.max(1, weeks.length - 1);
    const y = (v: number) => T + (H - T - B) * (1 - v / top);
    const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: 'img', 'aria-label': 'Register clicks and forms submitted per week' });

    for (let v = 0; v <= top; v += step) {
      svg.append(svgEl('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: 'var(--gd-grid)', 'stroke-width': 1 }));
      const t = svgEl('text', { x: L - 6, y: y(v) + 4, 'text-anchor': 'end' });
      t.textContent = String(v);
      svg.append(t);
    }
    weeks.forEach((w, i) => {
      if ((weeks.length - 1 - i) % labelEvery) return;
      const t = svgEl('text', { x: x(i), y: H - 6, 'text-anchor': 'middle' });
      t.textContent = weekLabel(w.week);
      svg.append(t);
    });
    const series = [
      { key: 'clicks' as const, color: 'var(--gd-s1)' },
      { key: 'submits' as const, color: 'var(--gd-s2)' },
    ];
    for (const s of series) {
      const d = weeks.map((w, i) => `${i ? 'L' : 'M'}${x(i)},${y(w[s.key])}`).join(' ');
      svg.append(svgEl('path', { d, fill: 'none', stroke: s.color, 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }));
    }

    // Hover: crosshair, a dot per series and a tooltip for the nearest week.
    const cross = svgEl('line', { y1: T, y2: H - B, stroke: 'var(--text-light)', 'stroke-width': 1, visibility: 'hidden' });
    const dots = series.map((s) => svgEl('circle', { r: 4, fill: s.color, stroke: '#fff', 'stroke-width': 2, visibility: 'hidden' }));
    svg.append(cross, ...dots);
    const tip = el('div', 'gd-tip');
    tip.hidden = true;
    const hit = svgEl('rect', { x: L, y: T, width: W - L - R, height: H - T - B, fill: 'transparent' });
    svg.append(hit);
    const show = (clientX: number) => {
      const r = svg.getBoundingClientRect();
      const vx = ((clientX - r.left) / r.width) * W;
      const i = Math.max(0, Math.min(weeks.length - 1, Math.round(((vx - L) / (W - L - R)) * (weeks.length - 1))));
      const w = weeks[i];
      cross.setAttribute('x1', String(x(i)));
      cross.setAttribute('x2', String(x(i)));
      cross.setAttribute('visibility', 'visible');
      series.forEach((s, j) => {
        dots[j].setAttribute('cx', String(x(i)));
        dots[j].setAttribute('cy', String(y(w[s.key])));
        dots[j].setAttribute('visibility', 'visible');
      });
      tip.textContent = '';
      tip.append(el('b', '', `Week of ${weekLabel(w.week)}`));
      tip.append(el('div', '', `Register clicks: ${fmt(w.clicks)}`), el('div', '', `Forms submitted: ${fmt(w.submits)}`));
      tip.hidden = false;
      const px = (x(i) / W) * r.width;
      tip.style.left = `${Math.max(70, Math.min(r.width - 70, px))}px`;
    };
    const hide = () => {
      tip.hidden = true;
      cross.setAttribute('visibility', 'hidden');
      dots.forEach((d) => d.setAttribute('visibility', 'hidden'));
    };
    hit.addEventListener('pointermove', (e) => show((e as PointerEvent).clientX));
    hit.addEventListener('pointerdown', (e) => show((e as PointerEvent).clientX));
    hit.addEventListener('pointerleave', hide);
    box.append(svg, tip);
  }

  let last: Report | null = null;
  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => last && renderTrend(last.weeks), 150);
  });

  function render(r: Report) {
    last = r;
    $('gd-visits').textContent = fmt(r.site.sessions);
    $('gd-bounce').textContent = pct(r.site.bounceRate);
    renderRegistrations(r.courses, r.registrations ?? null);
    renderFunnels(r.courses, r.unassigned);
    renderReading(r.courses);
    renderList('gd-faq', (r.faq ?? []).map((f) => ({ label: f.question, count: f.count })), 'No questions opened in this period.');
    const wa = r.whatsapp ?? { total: 0, pages: [] };
    $('gd-wa-total').textContent = `· ${fmt(wa.total)}`;
    renderList('gd-wa', wa.pages.map((p) => ({ label: pageName(p.path), count: p.count })), 'No WhatsApp clicks in this period.');
    renderTrend(r.weeks);
    renderSources(r.channels);
    renderSearch(r.search ?? null);
    const at = new Date(r.generatedAt);
    $('gd-updated').textContent = `Numbers from Google Analytics, Search Console and the response sheets, ${at.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}. They refresh every 10 minutes; today's numbers can take a few hours to appear in full.`;
  }

  /** Clearly fake numbers so the layout can be worked on locally. */
  function demo(days: number): Report {
    const f = days / 28;
    const weeks = Array.from({ length: 12 }, (_, i) => {
      const d = new Date(Date.now() - (11 - i) * 7 * 86400000);
      const t = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
      t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7));
      const wk = Math.ceil(((t.getTime() - Date.UTC(t.getUTCFullYear(), 0, 1)) / 86400000 + 1) / 7);
      return { week: `${t.getUTCFullYear()}${String(wk).padStart(2, '0')}`, clicks: [3, 5, 2, 6, 8, 4, 7, 9, 5, 6, 10, 8][i], submits: [1, 2, 1, 3, 4, 2, 3, 5, 2, 3, 6, 4][i] };
    });
    return {
      days,
      generatedAt: new Date().toISOString(),
      site: { sessions: Math.round(1200 * f), bounceRate: 0.52 },
      courses: [
        {
          slug: 'beginner-course', label: 'Beginners', pageSessions: Math.round(320 * f), clicks: Math.round(30 * f), submits: Math.round(12 * f),
          lang: { en: { pageSessions: Math.round(260 * f), clicks: Math.round(26 * f) }, de: { pageSessions: Math.round(60 * f), clicks: Math.round(4 * f) } },
          read: { expect: Math.round(250 * f), prices: Math.round(170 * f), faq: Math.round(110 * f), end: Math.round(80 * f) },
        },
        {
          slug: 'growth-sessions', label: 'Improvers', pageSessions: Math.round(80 * f), clicks: Math.round(8 * f), submits: Math.round(3 * f),
          lang: { en: { pageSessions: Math.round(70 * f), clicks: Math.round(7 * f) }, de: { pageSessions: Math.round(10 * f), clicks: Math.round(1 * f) } },
          read: { expect: Math.round(66 * f), prices: Math.round(50 * f), faq: Math.round(30 * f), end: Math.round(24 * f) },
        },
      ],
      unassigned: { clicks: 2, submits: 1 },
      channels: [
        { channel: 'Organic Social', sessions: Math.round(500 * f), bounceRate: 0.61, clicks: Math.round(14 * f) },
        { channel: 'Direct', sessions: Math.round(400 * f), bounceRate: 0.55, clicks: Math.round(12 * f) },
        { channel: 'Organic Search', sessions: Math.round(200 * f), bounceRate: 0.3, clicks: Math.round(9 * f) },
        { channel: 'Referral', sessions: Math.round(60 * f), bounceRate: 0.35, clicks: Math.round(3 * f) },
      ],
      weeks,
      faq: [
        { question: 'What should I wear?', count: Math.round(29 * f) },
        { question: 'Do I need to bring a partner?', count: Math.round(25 * f) },
        { question: 'Where exactly are you located in Cologne?', count: Math.round(22 * f) },
        { question: 'Do I need any dance experience to start?', count: Math.round(17 * f) },
        { question: "I'm shy. Will I feel awkward?", count: Math.round(4 * f) },
      ],
      registrations: {
        'beginner-course': { from: '2026-12-01', spots: 20, registered: 14, roles: { leader: 5, follower: 7, both: 2, unknown: 0 }, returning: 3 },
        'growth-sessions': { from: '2026-12-01', spots: 20, registered: 6, roles: { leader: 3, follower: 2, both: 1, unknown: 0 }, returning: 5 },
      },
      search: [
        { query: 'tango cologne', clicks: 12, impressions: 340, position: 4.2 },
        { query: 'tango köln anfänger', clicks: 6, impressions: 210, position: 7.8 },
        { query: 'tango garden', clicks: 18, impressions: 40, position: 1.1 },
        { query: 'argentine tango classes cologne english', clicks: 3, impressions: 90, position: 5.5 },
      ],
      whatsapp: {
        total: Math.round(20 * f),
        pages: [
          { path: '/pages/contact', count: Math.round(6 * f) },
          { path: '/', count: Math.round(3 * f) },
          { path: '/de/pages/the-garden', count: Math.round(2 * f) },
          { path: '/pages/beginner-course', count: Math.round(2 * f) },
        ],
      },
    };
  }

  const status = $('gd-status');
  async function load(days: number) {
    document.querySelectorAll<HTMLButtonElement>('.gd-periods button').forEach((b) =>
      b.setAttribute('aria-pressed', String(Number(b.dataset.days) === days))
    );
    status.className = 'gd-status';
    status.textContent = 'Loading the numbers…';
    try {
      const res = await fetch(`/gardeners-area/api/report?days=${days}`, { credentials: 'same-origin' });
      if (!res.ok) throw new Error(res.status === 401 ? 'You are not signed in, or this email has no access.' : `The data service answered ${res.status}.`);
      render(await res.json());
      status.textContent = '';
    } catch (err) {
      if (LOCAL) {
        render(demo(days));
        status.className = 'gd-status is-demo';
        status.textContent = 'Demo numbers: the data service only runs on tangogarden.de.';
      } else {
        status.className = 'gd-status is-error';
        status.textContent = `Couldn't load the numbers. ${(err as Error).message}`;
      }
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.gd-periods button').forEach((b) =>
    b.addEventListener('click', () => load(Number(b.dataset.days)))
  );
  load(28);
</script>
