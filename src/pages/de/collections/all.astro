---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductGrid from '../../../components/ProductGrid.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://tangogarden.de/de' },
    { '@type': 'ListItem', position: 2, name: 'Kurse & Pässe', item: 'https://tangogarden.de/de/collections/all' },
  ],
};
---

<BaseLayout
  title="Tango-Angebote in Köln: Termine & Preise | Tango Garden"
  description="Probestunde, Anfängerkurs oder Practica: alle Tango-Angebote von Tango Garden in Köln mit Terminen und Preisen. Ermäßigt für Studierende und unter 28."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <ProductGrid locale="de" />
</BaseLayout>
