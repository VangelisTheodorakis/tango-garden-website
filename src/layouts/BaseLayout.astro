---
import MetaTags from '../components/MetaTags.astro';
import StructuredData from '../components/StructuredData.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { gaMeasurementId } from '../data/site.js';
import { basePath, getLocale } from '../i18n/index.js';
import { ui } from '../i18n/ui.js';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /**
   * BCP-47 tag for the page's own language. Defaults to the locale of the URL
   * (/de/... is German); the Impressum overrides it because its content is
   * German while its URL, and so its nav and footer, are English.
   */
  lang?: 'en' | 'de';
  canonical?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schema?: 'localbusiness' | 'product' | 'learningresource' | 'none';
  product?: {
    name: string;
    description: string;
    url: string;
    price: string;
    availability: 'InStock' | 'OutOfStock';
  };
  learningResource?: {
    name: string;
    description: string;
    url: string;
    teaches: string[];
    inLanguage?: 'en' | 'de';
  };
}

const locale = getLocale(Astro.url.pathname);
const {
  title,
  description,
  lang = locale,
  canonical,
  ogType = 'website',
  noindex = false,
  schema = 'none',
  product,
  learningResource,
} = Astro.props;

/**
 * GA4 content_group, so reports can compare the three pathway pages as one
 * group. Matched on the English path so both languages land in the same group.
 */
const pathname = basePath(Astro.url.pathname);
const contentGroup = pathname.startsWith('/pages/enter-the-garden')
  ? 'Enter the Garden'
  : pathname.startsWith('/pages/beginner-course')
    ? 'Beginner Course'
    : pathname.startsWith('/pages/garden-practica')
      ? 'Garden Practica'
      : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      href="/fonts/inter-v20-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <MetaTags
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      noindex={noindex}
      locale={locale}
    />
    <StructuredData type={schema} product={product} learningResource={learningResource} />
    {gaMeasurementId && (
      <>
        <meta name="ga-measurement-id" content={gaMeasurementId} />
        {contentGroup && <meta name="ga-content-group" content={contentGroup} />}
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{ui[locale].skipLink}</a>
    <Nav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      const gaId = document.querySelector('meta[name="ga-measurement-id"]')?.getAttribute('content');
      // Only the live site reports to GA. Dev servers, the test suites and
      // Lighthouse (locally and in CI) all run on localhost, and until this
      // check they made up over half of the recorded sessions.
      const PRODUCTION_HOSTS = ['tangogarden.de', 'www.tangogarden.de'];
      if (gaId && PRODUCTION_HOSTS.includes(location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() {
          // Must push `arguments` itself (not a rest-param array) — gtag.js's
          // dataLayer listener doesn't recognize a plain Array as a command.
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        const contentGroup = document
          .querySelector('meta[name="ga-content-group"]')
          ?.getAttribute('content');
        // content_group goes on the config call: GA4 never recorded it when it
        // was sent via gtag('set', 'content_group', …) — every page read (not set).
        window.gtag('config', gaId, contentGroup ? { content_group: contentGroup } : {});

        // Fetch gtag.js only once the page has loaded and painted: its ~170KB
        // download otherwise competes with the hero image and cost ~1s of
        // mobile LCP. Everything above (and any event fired before then) waits
        // in dataLayer and is sent as soon as it runs.
        const loadGtag = () => {
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
          document.head.append(script);
        };
        // Safari has no requestIdleCallback.
        const whenIdle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
        const afterLoad = () => whenIdle(loadGtag);
        if (document.readyState === 'complete') afterLoad();
        else window.addEventListener('load', afterLoad, { once: true });
      }
    </script>
  </body>
</html>
