---
import MetaTags from '../components/MetaTags.astro';
import StructuredData from '../components/StructuredData.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { gaMeasurementId } from '../data/site.js';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** BCP-47 tag for the page's own language — the German legal pages set 'de'. */
  lang?: 'en' | 'de';
  canonical?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schema?: 'localbusiness' | 'product' | 'none';
  product?: {
    name: string;
    description: string;
    url: string;
    price: string;
    availability: 'InStock' | 'OutOfStock';
  };
}

const {
  title,
  description,
  lang = 'en',
  canonical,
  ogType = 'website',
  noindex = false,
  schema = 'none',
  product,
} = Astro.props;

/** GA4 content_group, so reports can compare the three pathway pages as one group. */
const pathname = Astro.url.pathname;
const contentGroup = pathname.startsWith('/pages/enter-the-garden')
  ? 'Enter the Garden'
  : pathname.startsWith('/pages/beginner-course')
    ? 'Beginner Course'
    : pathname.startsWith('/pages/garden-practica')
      ? 'Garden Practica'
      : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      href="/fonts/inter-v20-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <MetaTags
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      noindex={noindex}
    />
    <StructuredData type={schema} product={product} />
    {gaMeasurementId && (
      <>
        <meta name="ga-measurement-id" content={gaMeasurementId} />
        {contentGroup && <meta name="ga-content-group" content={contentGroup} />}
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      const gaId = document.querySelector('meta[name="ga-measurement-id"]')?.getAttribute('content');
      if (gaId) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() {
          // Must push `arguments` itself (not a rest-param array) — gtag.js's
          // dataLayer listener doesn't recognize a plain Array as a command.
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        const contentGroup = document
          .querySelector('meta[name="ga-content-group"]')
          ?.getAttribute('content');
        if (contentGroup) {
          // `set` (not `config`) so content_group is attached to every
          // subsequent hit on this page, including outbound-click events.
          window.gtag('set', 'content_group', contentGroup);
        }
        window.gtag('config', gaId);
      }
    </script>
  </body>
</html>
