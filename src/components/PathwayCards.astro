---
/**
 * "Three Ways to Enter the Garden".
 *
 * The date line of each card is populated at runtime from a JSON file in
 * /assets/data/ — see the script at the bottom. The markup below carries the
 * last-known text as a fallback so the card is never blank if the fetch fails.
 */
import { localizePath } from '../i18n/index.js';

interface Props {
  locale?: 'en' | 'de';
}
const { locale = 'en' } = Astro.props;
const l = (href: string) => localizePath(href, locale);

const text = {
  en: {
    eyebrow: 'How to Start',
    h2: 'Three Ways to Enter the Garden',
    lead: 'Choose what feels right for where you are.',
    why: 'Young people are the future of tango. We keep a reduced rate so the next generation can always find their way onto the floor.',
    reduced: '* Reduced price for students and anyone aged 28 or under.',
    helpTitle: 'Still wandering?',
    helpBody:
      "Every dancer starts somewhere different. If you're not sure where you fit, we're happy to guide you personally.",
    seeAll: 'See all details',
    whatsapp: 'Chat on WhatsApp',
    privatePrompt: 'Prefer one-to-one?',
    privateLink: 'Private classes with Vangelis or Kristina →',
    whatsappHref:
      "https://wa.me/491602368723?text=Hi!%20I'm%20not%20sure%20which%20option%20is%20right%20for%20me...",
    cards: [
      {
        title: 'Enter the Garden',
        description: 'Free introductory class for anyone who wants to try tango.',
        features: ['One-time 1-hour class', 'Connect with new people', 'Outdoors at Rheinpark'],
        dateLabel: 'Next introductory class',
        dateFallback: 'New dates coming soon (TBA)',
        price: 'Free of charge',
        cta: 'Free tango class in Cologne →',
      },
      {
        title: 'Regular Classes',
        description: 'A 12-week Argentine tango beginner course.',
        features: [
          '12 weekly 75-minute sessions',
          'Community events & rituals',
          'Make up missed classes for free',
        ],
        dateLabel: 'Next Beginner Tango Course ⭐',
        dateFallback: 'No upcoming dates scheduled (TBA)',
        price: 'from €13 or €10*/class',
        cta: 'See beginner tango course →',
      },
      {
        title: 'Garden Practica',
        description: 'A relaxed, guided practica for anyone who has taken at least one tango class.',
        features: [
          '2-hour guided sessions, 2nd and 4th Wednesday of each month',
          'Open-level and double-role',
          'Community-focused atmosphere',
        ],
        dateLabel: 'Next Practica',
        dateFallback: 'Wed, 22/07/2026, 19:30 – 22:00',
        price: '€10 or €8*',
        cta: 'See tango practica details →',
      },
    ],
  },
  de: {
    eyebrow: 'So startest du',
    h2: 'Drei Wege in den Garten',
    lead: 'Wähl, was sich für dich gerade richtig anfühlt.',
    why: 'Junge Menschen sind die Zukunft des Tango. Deshalb gibt es einen ermäßigten Preis, damit die nächste Generation immer ihren Weg auf die Tanzfläche findet.',
    reduced: '* Ermäßigt für Studierende und alle bis 28 Jahre.',
    helpTitle: 'Noch unentschlossen?',
    helpBody:
      'Alle fangen woanders an. Wenn du nicht sicher bist, was zu dir passt, helfen wir dir gerne persönlich weiter.',
    seeAll: 'Alle Details ansehen',
    whatsapp: 'Auf WhatsApp schreiben',
    privatePrompt: 'Lieber ganz persönlich?',
    privateLink: 'Privatunterricht mit Vangelis oder Kristina →',
    whatsappHref:
      'https://wa.me/491602368723?text=Hi!%20Ich%20bin%20mir%20nicht%20sicher%2C%20welches%20Angebot%20zu%20mir%20passt...',
    cards: [
      {
        title: 'Enter the Garden',
        description: 'Kostenlose Probestunde für alle, die Tango ausprobieren möchten.',
        features: ['Eine einmalige Stunde', 'Neue Leute kennenlernen', 'Draußen im Rheinpark'],
        dateLabel: 'Nächste Probestunde',
        dateFallback: 'Neue Termine folgen bald',
        price: 'Kostenlos',
        cta: 'Kostenlose Probestunde →',
      },
      {
        title: 'Anfängerkurs',
        description: 'Ein 12-wöchiger Tango-Argentino-Kurs für Anfänger:innen.',
        features: [
          '12 wöchentliche Stunden à 75 Min.',
          'Community-Events & Rituale',
          'Verpasste Stunden kostenlos nachholen',
        ],
        dateLabel: 'Nächster Tango-Anfängerkurs ⭐',
        dateFallback: 'Aktuell keine Termine geplant',
        // "\n" marks a line break in the rendered price.
        price: 'ab 13 € oder 10 €*\npro Stunde',
        cta: 'Zum Tango-Anfängerkurs →',
      },
      {
        title: 'Garden Practica',
        description: 'Eine entspannte, geführte Practica für alle, die schon mindestens eine Tango-Stunde hatten.',
        features: [
          '2 Stunden, angeleitet, am 2. und 4. Mittwoch im Monat',
          'Alle Level, auch Double-Role',
          'Community im Mittelpunkt',
        ],
        dateLabel: 'Nächste Practica',
        dateFallback: 'Neue Termine folgen bald',
        price: '10 € oder 8 €*',
        cta: 'Zur Tango-Practica →',
      },
    ],
  },
}[locale];

/** Per-card structure; the words come from `text` above. */
const shape = [
  { key: 'etg', number: '1', icon: '🌱', href: '/pages/enter-the-garden', featured: false },
  { key: 'rc', number: '2', icon: '🌿', href: '/pages/beginner-course', featured: true },
  { key: 'prac', number: '3', icon: '🌳', href: '/pages/garden-practica', featured: false },
];

const cards = shape.map((c, i) => {
  const t = text.cards[i];
  return {
    ...c,
    ...t,
    cta: { label: t.cta, href: l(c.href) },
    priceNote: undefined as string | undefined,
    secondaryCta: undefined as { label: string; href: string } | undefined,
  };
});
---

<section id="three-ways-to-enter" style="background: white; padding: 70px 20px;">
  <div class="container" style="max-width: 1200px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 80px;">
      <div
        style="font-size: 14px; text-transform: uppercase; letter-spacing: 2px; color: #4E5D22; font-weight: 600; margin-bottom: 20px;"
      >
        {text.eyebrow}
      </div>
      <h2
        style="font-size: 42px; font-weight: 700; color: #4E5D22; margin-bottom: 25px; line-height: 1.2;"
      >
        {text.h2}
      </h2>
      <p style="font-size: 20px; color: #666; max-width: 700px; margin: 0 auto; line-height: 1.6;">
        {text.lead}
      </p>
    </div>

    <div class="garden-pathways-grid">
      {
        cards.map((card) => (
          <div class:list={['pathway-card', { featured: card.featured }]}>
            <div class="card-number" aria-hidden="true">{card.number}</div>
            <div class="card-icon" aria-hidden="true">{card.icon}</div>
            <h3 class="card-title">{card.title}</h3>
            <p class="card-desc">{card.description}</p>
            <ul class="card-features">
              {card.features.map((f) => (
                <li>
                  <span class="card-check" aria-hidden="true">✓</span>
                  {f}
                </li>
              ))}
            </ul>
            <div class="card-date">
              <span class="card-date-emoji" aria-hidden="true">🗓️</span>
              <div style="text-align: left;">
                <span class="date-label" id={`${card.key}-label`}>
                  {card.dateLabel}
                </span>
                <span class="date-value" id={`${card.key}-date`} set:html={card.dateFallback} />
              </div>
            </div>
            <div class="card-foot">
              <div class="card-price-wrap">
                <p class="card-price">
                  {card.price.split('\n').map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </p>
                {card.priceNote && <p class="card-price-note">{card.priceNote}</p>}
              </div>
              <a class="card-btn" href={card.cta.href}>
                {card.cta.label}
              </a>
              {card.secondaryCta && (
                <a class="card-btn-secondary" href={card.secondaryCta.href}>
                  {card.secondaryCta.label}
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div style="text-align: center;">
      <p class="pathways-why">
        {text.why}
      </p>
      <p style="margin: 0;">
        <span>{text.reduced}</span>
      </p>
    </div>

    <div
      style="text-align: center; margin-top: 40px; padding: 50px 30px; background: #F9F7F2; border: 1px solid rgba(45,80,22,0.1); border-radius: 20px;"
    >
      <h4 style="font-size: 22px; color: #4E5D22; margin-bottom: 12px; font-weight: 700;">
        {text.helpTitle}
      </h4>
      <p
        style="font-size: 16px; line-height: 1.6; color: #666; max-width: 500px; margin: 0 auto 30px;"
      >
        {text.helpBody}
      </p>
      <div
        style="display: flex; gap: 15px; justify-content: center; align-items: center; flex-direction: row; flex-wrap: wrap;"
      >
        <a
          href={l('/pages/classes')}
          class="safety-btn-info"
          style="display: inline-flex; align-items: center; padding: 12px 24px; color: #4E5D22; font-weight: 600; text-decoration: none; font-size: 15px; border-radius: 30px; background: rgba(45,80,22,0.05); border: 1px solid rgba(45,80,22,0.1); transition: all 0.2s ease;"
        >
          <span style="margin-right: 8px;">📋</span> {text.seeAll}
        </a>
        <a
          href={text.whatsappHref}
          class="safety-btn-primary"
          style="display: inline-flex; align-items: center; padding: 12px 24px; background: #4E5D22; color: white; font-weight: 600; text-decoration: none; font-size: 15px; border-radius: 30px; box-shadow: 0 4px 12px rgba(45,80,22,0.2); transition: all 0.3s ease; border: 1px solid transparent;"
        >
          <span style="margin-right: 8px;">💬</span> {text.whatsapp}
        </a>
      </div>
      <p class="pathways-private">
        {text.privatePrompt} <a href={l('/pages/private-classes')}>{text.privateLink}</a>
      </p>
    </div>
  </div>
</section>

<style>
  /* These were per-element inline styles in the original HTML. Moving them here
     lets the three cards share one template; the `.featured` variants below
     reproduce the light-on-green treatment of the middle card. */
  .card-number {
    position: absolute;
    top: -15px;
    right: -15px;
    width: 80px;
    height: 80px;
    background: rgba(45, 80, 22, 0.08);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    font-weight: 700;
    color: rgba(45, 80, 22, 0.15);
  }
  .featured .card-number {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.2);
  }

  .card-icon {
    width: 70px;
    height: 70px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 25px;
    font-size: 32px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }
  .featured .card-icon {
    background: rgba(255, 255, 255, 0.15);
    box-shadow: none;
    backdrop-filter: blur(10px);
  }

  .card-title {
    font-size: 26px;
    color: #4e5d22;
    margin-bottom: 15px;
    font-weight: 700;
  }
  .featured .card-title {
    color: white;
  }

  .card-desc {
    font-size: 16px;
    line-height: 1.7;
    color: #666;
    margin-bottom: 25px;
  }
  .featured .card-desc {
    color: rgba(255, 255, 255, 0.9);
  }

  .card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 30px 0;
    text-align: left;
  }
  .card-features li {
    font-size: 14px;
    color: #555;
    margin-bottom: 10px;
    padding-left: 25px;
    position: relative;
  }
  .featured .card-features li {
    color: rgba(255, 255, 255, 0.9);
  }
  .card-check {
    position: absolute;
    left: 0;
    color: #4e5d22;
    font-weight: 700;
  }
  .featured .card-check {
    color: white;
  }

  .card-date {
    margin-bottom: 25px;
    padding: 12px;
    background: rgba(45, 80, 22, 0.05);
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .featured .card-date {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .card-date-emoji {
    font-size: 16px;
    width: 20px;
    text-align: center;
  }
  .date-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    color: #4e5d22;
    font-weight: 700;
  }
  .featured .date-label {
    color: rgba(255, 255, 255, 0.8);
  }
  .date-value {
    display: block;
    position: relative;
    font-size: 15px;
    font-weight: 600;
    color: #4e5d22;
  }
  .date-value :global(.date-line) {
    display: block;
  }
  .date-value :global(.date-note) {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    font-weight: 500;
    opacity: 0.85;
  }
  /* The calendar emoji sits in a gutter column on the first date line. The side
     emoji element only keeps the column's width. */
  .card-date-emoji {
    visibility: hidden;
  }
  .date-value::before {
    position: absolute;
    left: -28px;
    width: 20px;
    text-align: center;
    font-size: 16px;
    line-height: inherit;
  }
  .date-value::before {
    content: '🗓️';
  }
  .featured .date-value {
    color: white;
  }

  /* Side by side, the date box and the price/button block get fixed minimum
     heights and the feature list absorbs the slack, so the separator lines sit
     at the same height on every card whatever the text above them does. */
  @media (min-width: 968px) {
    .card-features {
      flex-grow: 1;
    }
    .card-date {
      min-height: 112px;
    }
    /* Room for the green card's price on two lines (the German one wraps). */
    .pathway-card .card-foot {
      flex: 0 0 185px;
    }
  }

  /* Just past the three-column switch the cards are only ~290px wide: tighter
     side padding and a slightly smaller date text keep each course on one line. */
  @media (min-width: 968px) and (max-width: 1240px) {
    .pathway-card {
      padding-left: 20px;
      padding-right: 20px;
    }
    .date-value {
      font-size: 13px;
    }
    .card-date {
      min-height: 140px;
    }
    /* Fits the green card's price when it wraps to two lines here. */
    .pathway-card .card-foot {
      flex-basis: 210px;
    }
    /* The labels wrap at different widths here; a two-line minimum height keeps
       all three buttons the same size. */
    .pathway-card .card-btn {
      min-height: 85px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  .card-foot {
    border-top: 2px solid rgba(45, 80, 22, 0.1);
    /* Guarantees breathing room below the separator even on the card whose
       content above (date-status text especially) runs longer and would
       otherwise leave the price/button block with almost no flex-grow
       space to work with. */
    padding-top: 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .featured .card-foot {
    border-top-color: rgba(255, 255, 255, 0.2);
  }
  .card-price-wrap {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .card-price {
    font-size: 32px;
    font-weight: 700;
    color: #4e5d22;
    margin-bottom: 15px;
  }
  .featured .card-price {
    color: white;
  }
  /* Value framing: the big number is the hook, this muted line names the total
     so the per-class figure can never read as a hidden "€13 → €160" trap. */
  .card-price:has(+ .card-price-note) {
    margin-bottom: 2px;
  }
  .card-price-note {
    font-size: 13px;
    font-weight: 500;
    color: #666;
    margin: 0 0 15px;
  }
  .pathways-private {
    margin: 28px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: #666;
  }
  .pathways-private a {
    color: var(--green);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pathways-why {
    max-width: 620px;
    margin: 0 auto 14px;
    font-size: 19px;
    line-height: 1.5;
    font-weight: 600;
    color: #4e5d22;
  }
  .featured .card-price-note {
    color: rgba(255, 255, 255, 0.85);
  }

  .card-btn {
    display: block;
    background: white;
    color: #4e5d22;
    padding: 15px 30px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    border: 2px solid #4e5d22;
    transition: all 0.3s ease;
    /* When a label wraps (the cards are narrow between ~900 and 1200px),
       split it evenly instead of leaving one word on the second line. */
    text-wrap: balance;
  }
  /* Same border width (transparent) and no extra bottom margin, so the green
     card's button lines up with its neighbours. */
  .featured .card-btn {
    padding: 15px 20px;
    border-color: transparent;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }
  .card-btn + .card-btn-secondary {
    margin-top: 20px;
  }
  .card-btn-secondary {
    background: transparent;
    border: 2px solid white;
    color: white;
    padding: 10px 8px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
  }
</style>

<script>
  // Populate the pathway cards with dates from JSON. The selection rules live
  // in src/lib/next-event.js so they can be unit tested; this just renders.
  import { cardContent } from '../lib/next-event.js';

  const locale = document.documentElement.lang === 'de' ? 'de' : 'en';

  const feeds = [
    { url: '/assets/data/enter-the-garden.json', key: 'etg' },
    { url: '/assets/data/regular-classes.json', key: 'rc' },
    { url: '/assets/data/practicas.json', key: 'prac', oneLine: true },
  ];

  for (const feed of feeds) {
    fetch(feed.url, { cache: 'no-store' })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data) return;
        const labelEl = document.getElementById(`${feed.key}-label`);
        const dateEl = document.getElementById(`${feed.key}-date`);
        if (!dateEl) return;

        const { label, lines, note } = cardContent(data, new Date(), locale, {
          showYear: false,
          oneLine: feed.oneLine,
        });

        if (labelEl && label) labelEl.textContent = label;

        // textContent per line, not innerHTML — nothing from the feed is
        // parsed as markup.
        dateEl.textContent = '';
        // One block per line, plus a small note for courses that take registrations.
        lines.forEach((line) => {
          const row = document.createElement('span');
          row.className = 'date-line';
          row.textContent = line;
          dateEl.appendChild(row);
        });
        if (note) {
          const small = document.createElement('span');
          small.className = 'date-note';
          small.textContent = note;
          dateEl.appendChild(small);
        }
      })
      .catch(() => {
        /* keep the static fallback text on error */
      });
  }
</script>
