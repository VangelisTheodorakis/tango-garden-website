  .class-teacher-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 560px) {
    .class-teacher-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .class-teacher-card {
    background: var(--cream-light);
    border-radius: 14px;
