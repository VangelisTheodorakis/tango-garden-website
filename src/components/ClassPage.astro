---
/**
 * Renders one of the three consolidated class pages (Enter the Garden, the
 * Beginner Course, the Garden Practica) from a `classPages.js` entry. One
 * component, three thin page files — see src/pages/pages/*.astro — so the
 * markup for "what to expect / pricing table / FAQ" exists exactly once
 * instead of being hand-duplicated per class the way the old per-SKU product
 * pages were.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products.js';
import { absoluteUrl, formatPrice, localizePath } from '../i18n/index.js';

interface ClassPageEntry {
  slug: string;
  metaTitle: string;
  metaDescription: string;
  eyebrow?: string;
  heading: string;
  intro: string;
  feed: string;
  feedLabel: string;
  whatToExpect: string[];
  whatsIncluded: string[];
  table: {
    rows: {
      label: string;
      general: { handle: string };
      student: { handle: string } | null;
      perClass: { general: string; student: string } | null;
      bestValue: boolean;
      makeupIncluded?: boolean;
    }[];
  };
  cancellationNote: string | null;
  /** `key` is the English question, set on German items for analytics. */
  faq: { q: string; a: string; raw?: boolean; key?: string }[];
  offerHandles: string[];
  registerUrl?: string;
  /** File name in src/assets/. */
  heroImage?: string;
  gallery?: string[];
  showTeachers?: boolean;
  courseSchema: {
    name: string;
    description: string;
    duration: string;
    location: {
      name: string;
      streetAddress?: string;
      postalCode?: string;
      addressLocality: string;
    };
  };
}

interface Props {
  data: ClassPageEntry;
  locale?: 'en' | 'de';
}

const { data, locale = 'en' } = Astro.props;

// The hero is the LCP element, so it goes through astro:assets for srcset
// variants — phones download a ~750px image instead of the 1800px original.
const heroAssets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,webp}', { eager: true });
const heroImage = data.heroImage ? heroAssets[`../assets/${data.heroImage}`]?.default : undefined;
if (data.heroImage && !heroImage) throw new Error(`heroImage not found in src/assets: ${data.heroImage}`);

const text = {
  en: {
    home: 'Home',
    classes: 'Classes',
    loading: 'Loading dates…',
    languageNote: null,
    register: 'Reserve your spot',
    seePrices: 'See course prices\u00a0↓',
    registerNote: 'No payment required to register. Pay in cash or via PayPal at your first class.',
    paymentNote: 'All prices are paid in cash or via PayPal.',
    whereIsIt: '📍 Where is it?',
    whatToExpect: 'What to Expect',
    photo: 'photo',
    pricing: 'Pricing',
    pricingGroup: 'Pricing group',
    general: 'General',
    reduced: 'Reduced',
    tierHint: 'Reduced pricing for students and anyone aged 28 or under.',
    option: 'Option',
    price: 'Price',
    perClass: 'Per class',
    makeup: 'Free practica if you miss a class',
    refund: 'Refund within 1 week*',
    bestValue: 'Best value',
    refundNote:
      '* Refundable if the cancellation is made within 1 week of the pass purchase. After that, passes are non-refundable.',
    teachers: 'Meet Your Teachers',
    teacherRole: 'Lead Instructor',
    vangelisBio:
      'Built Tango Garden after discovering his love for community. He believes tradition means passing the fire forward, not worshipping the ashes.',
    kristinaBio:
      'Kristina focuses on helping students develop body awareness, confidence, and real connection, creating a space where people can grow both on and off the dance floor.',
    included: "What's Included",
    questions: 'Common Questions',
    nextStep: 'Ready to take the next step?',
    nextStepRegister: 'Register with the form below, or message us on WhatsApp with any questions first.',
    nextStepDropIn: 'No need to reserve a spot, just come. Message us on WhatsApp if you have any questions.',
    waMessage: (name: string) => `Hi! I have a question about ${name}.`,
    waLabel: '💬 Chat on WhatsApp',
  },
  de: {
    home: 'Startseite',
    classes: 'Kurse',
    loading: 'Termine werden geladen…',
    // Classes are taught in English; say so near the top of every German page.
    languageNote: 'Unterricht auf Englisch · Feedback auf Wunsch auch auf Deutsch, Griechisch oder Russisch',
    register: 'Platz reservieren',
    seePrices: 'Kurspreise ansehen\u00a0↓',
    registerNote:
      'Für die Anmeldung zahlst du nichts, bezahlt wird bar oder per PayPal in deiner ersten Stunde. Das Anmeldeformular ist auf Englisch.',
    paymentNote: 'Alle Preise zahlst du bar oder per PayPal.',
    whereIsIt: '📍 Wo ist das?',
    whatToExpect: 'Was dich erwartet',
    photo: 'Foto',
    pricing: 'Preise',
    pricingGroup: 'Preisgruppe',
    general: 'Regulär',
    reduced: 'Ermäßigt',
    tierHint: 'Ermäßigt für Studierende und alle bis 28 Jahre.',
    option: 'Option',
    price: 'Preis',
    perClass: 'Pro Stunde',
    makeup: 'Kostenlose Practica, wenn du eine Stunde verpasst',
    refund: 'Erstattung innerhalb 1 Woche*',
    bestValue: 'Bester Preis',
    refundNote:
      '* Erstattung möglich, wenn du innerhalb von 1 Woche nach dem Kauf des Passes stornierst. Danach sind Pässe nicht erstattbar.',
    teachers: 'Deine Lehrer:innen',
    teacherRole: 'Lead Instructor',
    vangelisBio:
      'Hat Tango Garden gegründet, nachdem er seine Liebe zur Community entdeckt hat. Für ihn heißt Tradition, das Feuer weiterzugeben, nicht die Asche anzubeten.',
    kristinaBio:
      'Kristina hilft dir, Körperbewusstsein, Selbstvertrauen und echte Verbindung zu entwickeln, in einem Raum, in dem du auf und neben der Tanzfläche wachsen kannst.',
    included: 'Was inklusive ist',
    questions: 'Häufige Fragen',
    nextStep: 'Bereit für den nächsten Schritt?',
    nextStepRegister:
      'Melde dich über das Formular an oder schreib uns vorher auf WhatsApp, wenn du Fragen hast.',
    nextStepDropIn:
      'Du musst keinen Platz reservieren, komm einfach vorbei. Schreib uns auf WhatsApp, wenn du Fragen hast.',
    waMessage: (name: string) => `Hi! Ich habe eine Frage zu ${name}.`,
    waLabel: '💬 Auf WhatsApp schreiben',
  },
}[locale];
const euro = (n: number | null) => (n == null ? '—' : formatPrice(`€${n}`, locale));

const productByHandle = (handle: string) => products.find((p) => p.handle === handle);

/** "€18,00 EUR" -> "€18". Falls back to the raw string (e.g. "Free"). */
const priceLabel = (handle: string) => {
  const price = productByHandle(handle)?.price ?? '';
  const match = price.match(/€(\d+)/);
  return formatPrice(match ? `€${match[1]}` : price, locale);
};

const priceNum = (handle: string) => {
  const price = productByHandle(handle)?.price ?? '';
  const match = price.match(/€(\d+)/);
  return match ? Number(match[1]) : null;
};

const perClassNum = (label: string) => {
  const match = label.match(/€(\d+)/);
  return match ? Number(match[1]) : null;
};

/** Pass price minus the cost of one class — the amount refunded on a within-1-week cancellation. */
const refundFor = (row: ClassPageEntry['table']['rows'][number]) => {
  if (!row.perClass) return null;
  const generalTotal = priceNum(row.general.handle);
  const generalPerClass = perClassNum(row.perClass.general);
  const general = generalTotal != null && generalPerClass != null ? generalTotal - generalPerClass : null;

  let student: number | null = null;
  if (row.student && row.perClass.student) {
    const studentTotal = priceNum(row.student.handle);
    const studentPerClass = perClassNum(row.perClass.student);
    student = studentTotal != null && studentPerClass != null ? studentTotal - studentPerClass : null;
  }
  return { general, student };
};

const canonical = absoluteUrl(localizePath(`/pages/${data.slug}`, locale));
const hasStudent = data.table.rows.some((r) => r.student);
const hasPerClass = data.table.rows.some((r) => r.perClass);
const hasMakeup = data.table.rows.some((r) => r.makeupIncluded !== undefined);
const hasPaidRow = data.table.rows.some((r) => productByHandle(r.general.handle)?.price !== 'Free');

const offers = data.offerHandles
  .map((h) => productByHandle(h)?.schema?.offers)
  .filter(Boolean);

const loc = data.courseSchema.location;
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: data.courseSchema.name,
  description: data.courseSchema.description,
  provider: {
    '@type': 'LocalBusiness',
    name: 'Tango Garden Cologne',
    url: 'https://tangogarden.de',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Onsite',
    location: {
      '@type': 'Place',
      name: loc.name,
      address: {
        '@type': 'PostalAddress',
        ...(loc.streetAddress && { streetAddress: loc.streetAddress }),
        ...(loc.postalCode && { postalCode: loc.postalCode }),
        addressLocality: loc.addressLocality,
        addressCountry: 'DE',
      },
    },
    courseSchedule: {
      '@type': 'Schedule',
      duration: data.courseSchema.duration,
      repeatFrequency: 'Weekly',
    },
  },
  offers,
  '@id': `${canonical}#course`,
  url: canonical,
};

// FAQ answers can carry a raw <a> (the map link) — schema.org wants text, not markup.
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: stripHtml(item.a) },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: text.home, item: absoluteUrl(localizePath('/', locale)) },
    { '@type': 'ListItem', position: 2, name: text.classes, item: absoluteUrl(localizePath('/collections/all', locale)) },
    { '@type': 'ListItem', position: 3, name: data.heading, item: canonical },
  ],
};

const mapQuery = [loc.streetAddress, loc.postalCode, loc.addressLocality].filter(Boolean).join(', ');
const mapUrl = mapQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}` : null;

// German headings are keyword phrases; the message names the class by its brand name.
const waMessage = text.waMessage(locale === 'de' ? (data.eyebrow ?? data.heading) : data.heading);
const waHref = `https://wa.me/491602368723?text=${encodeURIComponent(waMessage)}`;
const waLabel = text.waLabel;
---

<BaseLayout title={`${data.metaTitle} | Tango Garden`} description={data.metaDescription} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <section class:list={['class-hero', data.heroImage && 'class-hero--photo']}>
    {heroImage && (
      <Image
        class="class-hero-bg"
        src={heroImage}
        alt=""
        widths={[750, 1100, 1500, 1800]}
        sizes="100vw"
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
    )}
    {data.heroImage && <div class="class-hero-overlay" />}
    <div class="class-hero-content">
      {data.eyebrow && <div class="class-eyebrow">{data.eyebrow}</div>}
      <h1>{data.heading}</h1>
      <p class="class-intro">{data.intro}</p>
      {text.languageNote && <p class="class-language-note">{text.languageNote}</p>}
      <div class="class-schedule" data-feed={data.feed}>
        <span class="class-schedule-emoji" aria-hidden="true">🗓️</span>
        <div>
          <span class="class-schedule-label">{data.feedLabel}</span>
          <span class="class-schedule-date">{text.loading}</span>
        </div>
      </div>
      {data.registerUrl ? (
        <div class="class-btn-row">
          <a class="btn-register" href={data.registerUrl} target="_blank" rel="noopener">{text.register}</a>
          <a class="btn-ghost" href="#pricing">{text.seePrices}</a>
        </div>
      ) : (
        <a class="btn-whatsapp" href={waHref} target="_blank" rel="noopener">{waLabel}</a>
      )}
      {data.registerUrl && (
        <p class="class-cta-note">{text.registerNote}</p>
      )}
      {mapUrl && (
        <a class="class-location-toggle" href={mapUrl} target="_blank" rel="noopener">{text.whereIsIt}</a>
      )}
    </div>
  </section>

  <section class="class-section">
    <h2>{text.whatToExpect}</h2>
    {data.whatToExpect.map((p) => <p>{p}</p>)}
  </section>

  {data.gallery && data.gallery.length > 0 && (
    <section class="class-section">
      {data.gallery[0] && (
        <img class="class-gallery-wide" src={data.gallery[0]} alt={`${data.heading} ${text.photo} 1`} loading="lazy" />
      )}
      {data.gallery.length > 1 && (
        <div class="class-gallery-pair">
          {data.gallery.slice(1).map((src, i) => (
            <img src={src} alt={`${data.heading} ${text.photo} ${i + 2}`} loading="lazy" />
          ))}
        </div>
      )}
    </section>
  )}

  <section class="class-section" id="pricing">
    <h2>{text.pricing}</h2>
    {hasStudent && (
      <div class="class-tier-toggle" role="tablist" aria-label={text.pricingGroup}>
        <button type="button" class="class-tier-btn is-active" data-tier="general" role="tab" aria-selected="true">{text.general}</button>
        <button type="button" class="class-tier-btn" data-tier="student" role="tab" aria-selected="false">{text.reduced}</button>
      </div>
    )}
    {hasStudent && (
      <p class="class-tier-hint">{text.tierHint}</p>
    )}
    <div class="class-table-wrap" data-tier="general">
      <table class="class-table">
        <thead>
          <tr>
            <th scope="col">{text.option}</th>
            <th scope="col">{text.price}</th>
            {hasPerClass && <th scope="col">{text.perClass}</th>}
            {hasMakeup && <th scope="col">{text.makeup}</th>}
            {hasPerClass && <th scope="col">{text.refund}</th>}
          </tr>
        </thead>
        <tbody>
          {data.table.rows.map((row) => {
            const refund = refundFor(row);
            return (
              <tr>
                <th scope="row">
                  {row.label}
                  {row.bestValue && <span class="class-table-tag">{text.bestValue}</span>}
                </th>
                {hasStudent ? (
                  <td>
                    <span class="tier-value tier-general">{priceLabel(row.general.handle)}</span>
                    <span class="tier-value tier-student">{row.student ? priceLabel(row.student.handle) : '—'}</span>
                  </td>
                ) : (
                  <td>{priceLabel(row.general.handle)}</td>
                )}
                {hasPerClass && hasStudent && (
                  <td>
                    <span class="tier-value tier-general">{row.perClass ? formatPrice(row.perClass.general, locale) : '—'}</span>
                    <span class="tier-value tier-student">{row.perClass ? formatPrice(row.perClass.student, locale) : '—'}</span>
                  </td>
                )}
                {hasPerClass && !hasStudent && (
                  <td>{row.perClass ? formatPrice(row.perClass.general, locale) : '—'}</td>
                )}
                {hasMakeup && <td>{row.makeupIncluded ? '✓' : '—'}</td>}
                {hasPerClass && hasStudent && (
                  <td>
                    <span class="tier-value tier-general">{refund ? euro(refund.general) : '—'}</span>
                    <span class="tier-value tier-student">{refund && refund.student != null ? euro(refund.student) : '—'}</span>
                  </td>
                )}
                {hasPerClass && !hasStudent && (
                  <td>{refund ? euro(refund.general) : '—'}</td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {hasPaidRow && <p class="class-note">{text.paymentNote}</p>}
    {hasPerClass && (
      <p class="class-note">
        {text.refundNote}
      </p>
    )}
  </section>

  {data.showTeachers && (
    <section class="class-section">
      <h2>{text.teachers}</h2>
      <div class="class-teacher-cards">
        <div class="class-teacher-card">
          <img src="/images/vangelis.webp" alt="Vangelis Theodorakis" loading="lazy" />
          <div class="class-teacher-card-body">
            <h3>Vangelis Theodorakis</h3>
            <p class="class-teacher-role">{text.teacherRole}</p>
            <p>{text.vangelisBio}</p>
          </div>
        </div>
        <div class="class-teacher-card">
          <img src="/images/kristina.webp" alt="Kristina Yanushko" loading="lazy" />
          <div class="class-teacher-card-body">
            <h3>Kristina Yanushko</h3>
            <p class="class-teacher-role">{text.teacherRole}</p>
            <p>{text.kristinaBio}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  {data.whatsIncluded.length > 0 && (
    <section class="class-section">
      <h2>{text.included}</h2>
      <ul class="class-included">
        {data.whatsIncluded.map((i) => <li>{i}</li>)}
      </ul>
      {data.cancellationNote && <p class="class-cancellation">{data.cancellationNote}</p>}
    </section>
  )}

  <section class="class-section class-faq">
    <h2>{text.questions}</h2>
    {data.faq.map((item) => (
      <div class="class-faq-item">
        <button class="class-faq-question" aria-expanded="false" data-faq-key={item.key}>
          {item.q}
        </button>
        <div class="class-faq-answer" hidden={true}>
          {item.raw ? (
            <div class="class-faq-answer-inner" set:html={item.a} />
          ) : (
            <div class="class-faq-answer-inner">{item.a}</div>
          )}
        </div>
      </div>
    ))}
  </section>

  <section class="class-cta">
    <h2>{text.nextStep}</h2>
    {data.registerUrl && <p>{text.nextStepRegister}</p>}
    {!data.registerUrl && <p>{text.nextStepDropIn}</p>}
    {data.registerUrl ? (
      <div class="class-btn-row">
        <a class="btn-register" href={data.registerUrl} target="_blank" rel="noopener">{text.register}</a>
        <a class="btn-whatsapp" href={waHref} target="_blank" rel="noopener">{waLabel}</a>
      </div>
    ) : (
      <a class="btn-whatsapp" href={waHref} target="_blank" rel="noopener">{waLabel}</a>
    )}
    {data.registerUrl && <p class="class-cta-note">{text.registerNote}</p>}
  </section>
</BaseLayout>

<style>
  .class-hero {
    position: relative;
    background: var(--cream);
    padding: 70px 20px 50px;
    text-align: center;
  }
  .class-hero--photo {
    background: none;
    overflow: hidden;
  }
  .class-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .class-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(243, 237, 225, 0.82);
    z-index: 1;
  }
  .class-hero-content {
    position: relative;
    z-index: 2;
  }
  .class-eyebrow {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--green);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .class-hero h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
    color: var(--green);
    margin-bottom: 18px;
    line-height: 1.15;
  }
  .class-intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-mid);
    max-width: 620px;
    margin: 0 auto 28px;
  }
  .class-language-note {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--green);
    max-width: 620px;
    margin: -16px auto 24px;
  }
  .class-schedule {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(78, 93, 34, 0.06);
    border-radius: 8px;
    padding: 12px 18px;
    margin: 0 auto 28px;
    width: fit-content;
    max-width: 100%;
    text-align: left;
  }
  .class-schedule-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--green);
    font-weight: 700;
  }
  .class-schedule-date {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--green);
  }
  .class-hero--photo .class-schedule {
    background: var(--green);
  }
  .class-hero--photo .class-schedule-label,
  .class-hero--photo .class-schedule-date {
    color: #efecec;
  }
  .class-hero--photo .btn-ghost {
    background: var(--green);
    color: #efecec;
    border-color: var(--green);
  }
  .class-hero--photo .btn-ghost:hover {
    background: var(--green-btn);
    border-color: var(--green-btn);
  }

  .class-section {
    max-width: 760px;
    margin: 0 auto;
    padding: 50px 20px;
  }
  .class-section h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 1rem;
  }
  .class-section p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-mid);
    margin-bottom: 1rem;
  }

  .class-tier-toggle {
    display: flex;
    flex-wrap: wrap;
    width: fit-content;
    gap: 4px;
    background: var(--cream-light);
    border-radius: 999px;
    padding: 4px;
    margin: 0 auto 0.6rem;
  }
  .class-tier-btn {
    border: none;
    background: none;
    font-family: inherit;
    cursor: pointer;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--green);
    transition: background 0.2s, color 0.2s;
  }
  .class-tier-btn.is-active {
    background: var(--green);
    color: #fff;
  }
  .class-tier-hint {
    font-size: 0.85rem;
    color: var(--text-light);
    text-align: center;
    margin-bottom: 1rem;
  }
  .class-table-wrap {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid rgba(78, 93, 34, 0.12);
  }
  .class-table-wrap[data-tier="general"] .tier-value.tier-student {
    display: none;
  }
  .class-table-wrap[data-tier="student"] .tier-value.tier-general {
    display: none;
  }
  .class-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }
  .class-table th,
  .class-table td {
    padding: 0.85rem 1rem;
    text-align: left;
    font-size: 0.92rem;
    vertical-align: top;
  }
  .class-table td {
    white-space: nowrap;
  }
  .class-table thead th {
    background: var(--cream-light);
    color: var(--green);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: normal;
  }
  .class-table tbody th {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .class-table tbody tr + tr td,
  .class-table tbody tr + tr th {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  .class-table-tag {
    display: block;
    margin-top: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--green);
    color: #fff;
    font-size: 0.68rem;
