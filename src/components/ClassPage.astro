---
/**
 * Renders one of the three consolidated class pages (Enter the Garden, the
 * Beginner Course, the Garden Practica) from a `classPages.js` entry. One
 * component, three thin page files — see src/pages/pages/*.astro — so the
 * markup for "what to expect / pricing table / FAQ" exists exactly once
 * instead of being hand-duplicated per class the way the old per-SKU product
 * pages were.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products.js';

interface ClassPageEntry {
  slug: string;
  metaTitle: string;
  metaDescription: string;
  eyebrow?: string;
  heading: string;
  intro: string;
  feed: string;
  feedLabel: string;
  whatToExpect: string[];
  whatsIncluded: string[];
  table: {
    rows: {
      label: string;
      general: { handle: string };
      student: { handle: string } | null;
      perClass: { general: string; student: string } | null;
      bestValue: boolean;
      makeupIncluded?: boolean;
    }[];
  };
  cancellationNote: string | null;
  faq: { q: string; a: string; raw?: boolean }[];
  offerHandles: string[];
  registerUrl?: string;
  heroImage?: string;
  gallery?: string[];
  showTeachers?: boolean;
  courseSchema: {
    name: string;
    description: string;
    duration: string;
    location: {
      name: string;
      streetAddress?: string;
      postalCode?: string;
      addressLocality: string;
    };
  };
}

interface Props {
  data: ClassPageEntry;
}

const { data } = Astro.props;

const productByHandle = (handle: string) => products.find((p) => p.handle === handle);

/** "€18,00 EUR" -> "€18". Falls back to the raw string (e.g. "Free"). */
const priceLabel = (handle: string) => {
  const price = productByHandle(handle)?.price ?? '';
  const match = price.match(/€(\d+)/);
  return match ? `€${match[1]}` : price;
};

const priceNum = (handle: string) => {
  const price = productByHandle(handle)?.price ?? '';
  const match = price.match(/€(\d+)/);
  return match ? Number(match[1]) : null;
};

const perClassNum = (label: string) => {
  const match = label.match(/€(\d+)/);
  return match ? Number(match[1]) : null;
};

/** Pass price minus the cost of one class — the amount refunded on a within-1-week cancellation. */
const refundFor = (row: ClassPageEntry['table']['rows'][number]) => {
  if (!row.perClass) return null;
  const generalTotal = priceNum(row.general.handle);
  const generalPerClass = perClassNum(row.perClass.general);
  const general = generalTotal != null && generalPerClass != null ? generalTotal - generalPerClass : null;

  let student: number | null = null;
  if (row.student && row.perClass.student) {
    const studentTotal = priceNum(row.student.handle);
    const studentPerClass = perClassNum(row.perClass.student);
    student = studentTotal != null && studentPerClass != null ? studentTotal - studentPerClass : null;
  }
  return { general, student };
};

const canonical = `https://tangogarden.de/pages/${data.slug}`;
const hasStudent = data.table.rows.some((r) => r.student);
const hasPerClass = data.table.rows.some((r) => r.perClass);
const hasMakeup = data.table.rows.some((r) => r.makeupIncluded !== undefined);

const offers = data.offerHandles
  .map((h) => productByHandle(h)?.schema?.offers)
  .filter(Boolean);

const loc = data.courseSchema.location;
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: data.courseSchema.name,
  description: data.courseSchema.description,
  provider: {
    '@type': 'LocalBusiness',
    name: 'Tango Garden Cologne',
    url: 'https://tangogarden.de',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Onsite',
    location: {
      '@type': 'Place',
      name: loc.name,
      address: {
        '@type': 'PostalAddress',
        ...(loc.streetAddress && { streetAddress: loc.streetAddress }),
        ...(loc.postalCode && { postalCode: loc.postalCode }),
        addressLocality: loc.addressLocality,
        addressCountry: 'DE',
      },
    },
    courseSchedule: {
      '@type': 'Schedule',
      duration: data.courseSchema.duration,
      repeatFrequency: 'Weekly',
    },
  },
  offers,
  '@id': `${canonical}#course`,
  url: canonical,
};

// FAQ answers can carry a raw <a> (the map link) — schema.org wants text, not markup.
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: stripHtml(item.a) },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tangogarden.de/' },
    { '@type': 'ListItem', position: 2, name: 'Classes', item: 'https://tangogarden.de/collections/all' },
    { '@type': 'ListItem', position: 3, name: data.heading, item: canonical },
  ],
};

const mapQuery = [loc.streetAddress, loc.postalCode, loc.addressLocality].filter(Boolean).join(', ');
const mapUrl = mapQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}` : null;

const waMessage = `Hi! I have a question about ${data.heading}.`;
const waHref = `https://wa.me/491602368723?text=${encodeURIComponent(waMessage)}`;
const waLabel = '💬 Chat on WhatsApp';
---

<BaseLayout title={`${data.metaTitle} | Tango Garden`} description={data.metaDescription} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <section class:list={['class-hero', data.heroImage && 'class-hero--photo']}>
    {data.heroImage && <img class="class-hero-bg" src={data.heroImage} alt="" loading="eager" />}
    {data.heroImage && <div class="class-hero-overlay" />}
    <div class="class-hero-content">
      {data.eyebrow && <div class="class-eyebrow">{data.eyebrow}</div>}
      <h1>{data.heading}</h1>
      <p class="class-intro">{data.intro}</p>
      <div class="class-schedule" data-feed={data.feed}>
        <span class="class-schedule-emoji" aria-hidden="true">🗓️</span>
        <div>
          <span class="class-schedule-label">{data.feedLabel}</span>
          <span class="class-schedule-date">Loading dates…</span>
        </div>
      </div>
      {data.registerUrl ? (
        <div class="class-btn-row">
          <a class="btn-register" href={data.registerUrl} target="_blank" rel="noopener">Reserve your spot</a>
          <a class="btn-ghost" href="#pricing">See course prices&nbsp;↓</a>
        </div>
      ) : (
        <a class="btn-whatsapp" href={waHref} target="_blank" rel="noopener">{waLabel}</a>
      )}
      {data.registerUrl && (
        <p class="class-cta-note">No payment required to register. Pay in cash at your first class.</p>
      )}
      {mapUrl && (
        <a class="class-location-toggle" href={mapUrl} target="_blank" rel="noopener">📍 Where is it?</a>
      )}
    </div>
  </section>

  <section class="class-section">
    <h2>What to Expect</h2>
    {data.whatToExpect.map((p) => <p>{p}</p>)}
  </section>

  {data.gallery && data.gallery.length > 0 && (
    <section class="class-section">
      {data.gallery[0] && (
        <img class="class-gallery-wide" src={data.gallery[0]} alt={`${data.heading} photo 1`} loading="lazy" />
      )}
      {data.gallery.length > 1 && (
        <div class="class-gallery-pair">
          {data.gallery.slice(1).map((src, i) => (
            <img src={src} alt={`${data.heading} photo ${i + 2}`} loading="lazy" />
          ))}
        </div>
      )}
    </section>
  )}

  <section class="class-section" id="pricing">
    <h2>Pricing</h2>
    {hasStudent && (
      <div class="class-tier-toggle" role="tablist" aria-label="Pricing group">
        <button type="button" class="class-tier-btn is-active" data-tier="general" role="tab" aria-selected="true">General</button>
        <button type="button" class="class-tier-btn" data-tier="student" role="tab" aria-selected="false">Reduced</button>
      </div>
    )}
    {hasStudent && (
      <p class="class-tier-hint">Reduced pricing for students and anyone aged 28 or under. No proof needed.</p>
    )}
    <div class="class-table-wrap" data-tier="general">
      <table class="class-table">
        <thead>
          <tr>
            <th scope="col">Option</th>
            <th scope="col">Price</th>
            {hasPerClass && <th scope="col">Per class</th>}
            {hasMakeup && <th scope="col">Free practica if you miss a class</th>}
            {hasPerClass && <th scope="col">Refund within 1 week†</th>}
          </tr>
        </thead>
        <tbody>
          {data.table.rows.map((row) => {
            const refund = refundFor(row);
            return (
              <tr>
                <th scope="row">
                  {row.label}
                  {row.bestValue && <span class="class-table-tag">Best value</span>}
                </th>
                {hasStudent ? (
                  <td>
                    <span class="tier-value tier-general">{priceLabel(row.general.handle)}</span>
                    <span class="tier-value tier-student">{row.student ? priceLabel(row.student.handle) : '—'}</span>
                  </td>
                ) : (
                  <td>{priceLabel(row.general.handle)}</td>
                )}
                {hasPerClass && hasStudent && (
                  <td>
                    <span class="tier-value tier-general">{row.perClass ? row.perClass.general : '—'}</span>
                    <span class="tier-value tier-student">{row.perClass ? row.perClass.student : '—'}</span>
                  </td>
                )}
                {hasPerClass && !hasStudent && (
                  <td>{row.perClass ? row.perClass.general : '—'}</td>
                )}
                {hasMakeup && <td>{row.makeupIncluded ? '✓' : '—'}</td>}
                {hasPerClass && hasStudent && (
                  <td>
                    <span class="tier-value tier-general">{refund ? `€${refund.general}` : '—'}</span>
                    <span class="tier-value tier-student">{refund && refund.student != null ? `€${refund.student}` : '—'}</span>
                  </td>
                )}
                {hasPerClass && !hasStudent && (
                  <td>{refund ? `€${refund.general}` : '—'}</td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {hasPerClass && (
      <p class="class-note">
        † Refundable if the cancellation is made within 1 week of the pass purchase. After that, passes are non-refundable.
      </p>
    )}
  </section>

  {data.showTeachers && (
    <section class="class-section">
      <h2>Meet Your Teachers</h2>
      <div class="class-teacher-cards">
        <div class="class-teacher-card">
          <img src="/images/vangelis.webp" alt="Vangelis Theodorakis" loading="lazy" />
          <div class="class-teacher-card-body">
            <h3>Vangelis Theodorakis</h3>
            <p class="class-teacher-role">Lead Instructor</p>
            <p>Built Tango Garden after discovering his love for community. He believes tradition means passing the fire forward, not worshipping the ashes.</p>
          </div>
        </div>
        <div class="class-teacher-card">
          <img src="/images/kristina.webp" alt="Kristina Yanushko" loading="lazy" />
          <div class="class-teacher-card-body">
            <h3>Kristina Yanushko</h3>
            <p class="class-teacher-role">Lead Instructor</p>
            <p>Kristina focuses on helping students develop body awareness, confidence, and real connection, creating a space where people can grow both on and off the dance floor.</p>
          </div>
        </div>
      </div>
    </section>
  )}

  {data.whatsIncluded.length > 0 && (
    <section class="class-section">
      <h2>What's Included</h2>
      <ul class="class-included">
        {data.whatsIncluded.map((i) => <li>{i}</li>)}
      </ul>
      {data.cancellationNote && <p class="class-cancellation">{data.cancellationNote}</p>}
    </section>
  )}

  <section class="class-section class-faq">
    <h2>Common Questions</h2>
    {data.faq.map((item) => (
      <div class="class-faq-item">
        <button class="class-faq-question" aria-expanded="false">
          {item.q}
        </button>
        <div class="class-faq-answer" hidden={true}>
          {item.raw ? (
            <div class="class-faq-answer-inner" set:html={item.a} />
          ) : (
            <div class="class-faq-answer-inner">{item.a}</div>
          )}
        </div>
      </div>
    ))}
  </section>

  <section class="class-cta">
    <h2>Ready to take the next step?</h2>
    {data.registerUrl && <p>Register with the form below, or message us on WhatsApp with any questions first.</p>}
    {!data.registerUrl && <p>No need to reserve a spot, just come. Message us on WhatsApp if you have any questions.</p>}
    {data.registerUrl ? (
      <div class="class-btn-row">
        <a class="btn-register" href={data.registerUrl} target="_blank" rel="noopener">Reserve your spot</a>
        <a class="btn-whatsapp" href={waHref} target="_blank" rel="noopener">{waLabel}</a>
      </div>
    ) : (
      <a class="btn-whatsapp" href={waHref} target="_blank" rel="noopener">{waLabel}</a>
    )}
    {data.registerUrl && <p class="class-cta-note">No payment required to register. Pay in cash at your first class.</p>}
  </section>
</BaseLayout>

<style>
  .class-hero {
    position: relative;
    background: var(--cream);
    padding: 70px 20px 50px;
    text-align: center;
  }
  .class-hero--photo {
    background: none;
    overflow: hidden;
  }
  .class-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .class-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(243, 237, 225, 0.82);
    z-index: 1;
  }
  .class-hero-content {
    position: relative;
    z-index: 2;
  }
  .class-eyebrow {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--green);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .class-hero h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
    color: var(--green);
    margin-bottom: 18px;
    line-height: 1.15;
  }
  .class-intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-mid);
    max-width: 620px;
    margin: 0 auto 28px;
  }
  .class-schedule {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(78, 93, 34, 0.06);
    border-radius: 8px;
    padding: 12px 18px;
    margin: 0 auto 28px;
    width: fit-content;
    max-width: 100%;
    text-align: left;
  }
  .class-schedule-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--green);
    font-weight: 700;
  }
  .class-schedule-date {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--green);
  }
  .class-hero--photo .class-schedule {
    background: var(--green);
  }
  .class-hero--photo .class-schedule-label,
  .class-hero--photo .class-schedule-date {
    color: #efecec;
  }
  .class-hero--photo .btn-ghost {
    background: var(--green);
    color: #efecec;
    border-color: var(--green);
  }
  .class-hero--photo .btn-ghost:hover {
    background: var(--green-btn);
    border-color: var(--green-btn);
  }

  .class-section {
    max-width: 760px;
    margin: 0 auto;
    padding: 50px 20px;
  }
  .class-section h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 1rem;
  }
  .class-section p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-mid);
    margin-bottom: 1rem;
  }

  .class-tier-toggle {
    display: flex;
    flex-wrap: wrap;
    width: fit-content;
    gap: 4px;
    background: var(--cream-light);
    border-radius: 999px;
    padding: 4px;
    margin: 0 auto 0.6rem;
  }
  .class-tier-btn {
    border: none;
    background: none;
    font-family: inherit;
    cursor: pointer;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--green);
    transition: background 0.2s, color 0.2s;
  }
  .class-tier-btn.is-active {
    background: var(--green);
    color: #fff;
  }
  .class-tier-hint {
    font-size: 0.85rem;
    color: var(--text-light);
    text-align: center;
    margin-bottom: 1rem;
  }
  .class-table-wrap {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid rgba(78, 93, 34, 0.12);
  }
  .class-table-wrap[data-tier="general"] .tier-value.tier-student {
    display: none;
  }
  .class-table-wrap[data-tier="student"] .tier-value.tier-general {
    display: none;
  }
  .class-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }
  .class-table th,
  .class-table td {
    padding: 0.85rem 1rem;
    text-align: left;
    font-size: 0.92rem;
    vertical-align: top;
  }
  .class-table td {
    white-space: nowrap;
  }
  .class-table thead th {
    background: var(--cream-light);
    color: var(--green);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: normal;
  }
  .class-table tbody th {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .class-table tbody tr + tr td,
  .class-table tbody tr + tr th {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  .class-table-tag {
    display: block;
    margin-top: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--green);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    width: fit-content;
  }
  .class-note {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-light);
  }

  .class-gallery-wide {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 14px;
  }
  .class-gallery-pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 12px;
  }
  .class-gallery-pair img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 14px;
  }
  @media (min-width: 560px) {
    .class-gallery-pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .class-teacher-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 560px) {
    .class-teacher-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .class-teacher-card {
    background: var(--cream-light);
    border-radius: 14px;
    overflow: hidden;
  }
  .class-teacher-card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .class-teacher-card-body {
    padding: 1.2rem 1.4rem 1.5rem;
    text-align: left;
  }
  .class-teacher-card-body h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.15rem;
  }
  .class-teacher-card-body p.class-teacher-role {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-light);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .class-teacher-card-body p:last-child {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-mid);
    margin-bottom: 0;
  }

  .class-included {
    padding-left: 0;
    list-style: none;
    margin-bottom: 1rem;
  }
  .class-included li {
    padding: 0.4rem 0 0.4rem 1.75rem;
    position: relative;
    font-size: 1rem;
    color: var(--text-mid);
    line-height: 1.7;
  }
  .class-included li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .class-cancellation {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.7;
    background: var(--cream-light);
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .class-faq-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .class-faq-item:first-of-type {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  .class-faq-question {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: 1.1rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--green);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-family: inherit;
  }
  .class-faq-question::after {
    content: '+';
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--green);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .class-faq-item.is-open .class-faq-question::after {
    transform: rotate(45deg);
  }
  .class-faq-answer-inner {
    padding-bottom: 1.1rem;
    font-size: 0.97rem;
    color: var(--text-mid);
    line-height: 1.75;
  }

  .class-cta {
    background: var(--cream);
    padding: 50px 20px;
    text-align: center;
  }
  .class-cta h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  .class-cta p {
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }
  .class-cta-note {
    margin: 1rem 0 0;
    font-size: 0.85rem;
    color: var(--text-light);
  }
  .class-btn-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .class-location-toggle {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    margin: 18px auto 0;
    background: rgba(78, 93, 34, 0.08);
    border: 1px solid rgba(78, 93, 34, 0.2);
    border-radius: 999px;
    padding: 10px 18px;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--green);
    transition: background 0.2s, transform 0.2s;
  }
  .class-location-toggle:hover {
    background: var(--green);
    color: #efecec;
    transform: translateY(-1px);
  }
  .btn-register {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 14px 32px;
    background: #C9703E;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 6px 16px rgba(201, 112, 62, 0.35);
    transition: background 0.3s, transform 0.2s;
  }
  .btn-register:hover {
    background: #b25f31;
    transform: translateY(-2px);
  }
</style>

<script>
  import { cardContent } from '../lib/next-event.js';

  const box = document.querySelector('.class-schedule') as HTMLElement | null;
  const feedUrl = box?.dataset.feed;
  const dateEl = box?.querySelector('.class-schedule-date') as HTMLElement | null;
  const labelEl = box?.querySelector('.class-schedule-label') as HTMLElement | null;

  if (feedUrl && dateEl) {
    fetch(feedUrl, { cache: 'no-store' })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data) return;
        const { label, lines } = cardContent(data, new Date());
        if (labelEl && label) labelEl.textContent = label;
        dateEl.textContent = '';
        lines.forEach((line, i) => {
          if (i > 0) dateEl.appendChild(document.createElement('br'));
          dateEl.appendChild(document.createTextNode(line));
        });
      })
      .catch(() => {
        if (dateEl) dateEl.textContent = 'New dates coming soon (TBA)';
      });
  }

  // Location disclosure, `hidden` as the source of truth so the map link
  // stays out of the tab order until the visitor asks to see it.
  // Pricing tier toggle: swaps which of the general/student values show in
  // the table without re-rendering it.
  const tierWrap = document.querySelector('.class-table-wrap') as HTMLElement | null;
  const tierButtons = document.querySelectorAll('.class-tier-btn') as NodeListOf<HTMLButtonElement>;
  tierButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tier = btn.dataset.tier;
      if (!tier || !tierWrap) return;
      tierWrap.dataset.tier = tier;
      tierButtons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
    });
  });

  // FAQ accordion, single-open, `hidden` as the source of truth for collapsed
  // state so closed answers are out of the tab order and the a11y tree.
  const buttons = document.querySelectorAll('.class-faq-question') as NodeListOf<HTMLButtonElement>;
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.class-faq-item');
      const panel = item?.querySelector('.class-faq-answer') as HTMLElement | null;
      if (!item || !panel) return;
      const willOpen = panel.hidden;

      for (const other of document.querySelectorAll('.class-faq-item.is-open')) {
        other.classList.remove('is-open');
        other.querySelector('.class-faq-question')?.setAttribute('aria-expanded', 'false');
        const otherPanel = other.querySelector('.class-faq-answer') as HTMLElement | null;
        if (otherPanel) otherPanel.hidden = true;
      }

      if (willOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
      }
    });
  });
</script>
