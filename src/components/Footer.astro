---
import { social } from '../data/nav.js';
import { getLocale, localizePath } from '../i18n/index.js';
import { ui } from '../i18n/ui.js';
import Icon from './Icons.astro';

const locale = getLocale(Astro.url.pathname);
const f = ui[locale].footer;
const l = (href: string) => localizePath(href, locale);

const connectLinks = [
  { href: l('/pages/the-garden'), label: f.theGarden },
  { href: l('/pages/contact'), label: f.contact },
];

const classLinks = [
  { href: l('/collections/all'), label: f.classesAndPasses },
  { href: l('/pages/enter-the-garden'), label: 'Enter the Garden' },
  { href: l('/pages/beginner-course'), label: 'Sprouting Sessions' },
  { href: l('/pages/garden-practica'), label: 'Garden Practica' },
];

const legalLinks = [
  { href: l('/pages/refund-and-cancellation-policy'), label: f.refund },
  { href: l('/pages/terms-of-service'), label: f.terms },
  { href: l('/pages/privacy-policy'), label: f.privacy },
  { href: l('/pages/code-of-care'), label: f.codeOfCare },
  { href: l('/pages/impressum'), label: 'Impressum' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-logo-col">
      <img src="/images/logo-stacked-light.svg" alt="Tango Garden" width="210" loading="lazy" />
    </div>
    <div class="footer-col">
      <h2 class="footer-heading">{f.connect}</h2>
      <ul class="footer-links" role="list">
        {connectLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="footer-col">
      <h2 class="footer-heading">{f.classes}</h2>
      <ul class="footer-links" role="list">
        {classLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="footer-col">
      <h2 class="footer-heading">{f.legal}</h2>
      <ul class="footer-links" role="list">
        {legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="footer-social">
    <a href={social.facebook} target="_blank" rel="noopener" aria-label="Facebook"
      ><Icon name="facebook" size={22} /></a
    >
    <a href={social.instagram} target="_blank" rel="noopener" aria-label="Instagram"
      ><Icon name="instagram" size={22} /></a
    >
    <a href={social.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp"
      ><Icon name="whatsapp" size={22} /></a
    >
  </div>
  <div class="footer-bottom">
    <p>© {year} Tango Garden Cologne · Thürmchenswall 21, 50668 Köln</p>
    {
      locale === 'de' ? (
        <p>Alle Preise sind Endpreise. Gemäß §19 UStG wird keine Umsatzsteuer berechnet.</p>
      ) : (
        <p>
          All prices are final prices. No VAT charged according to §19 UStG.<br />
          {/* lang marks the switch so screen readers do not read German with an English voice. */}
          <span lang="de"
            >Alle Preise sind Endpreise. Gemäß §19 UStG wird keine Umsatzsteuer berechnet.</span
          >
        </p>
      )
    }
    <p class="footer-credit">{f.credit}</p>
  </div>
</footer>
