---
/**
 * /pages/you-ve-got-tango: where the QR code on the printed gift card leads.
 * Laid out like the card itself (paper colour, logo, headline, line), with
 * the gift choice where the card has its QR code. Each choice is an anchor;
 * CSS :target shows only that gift's details, so it works without JS.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { giftCards, waLink, YEARS_TO_START } from '../data/giftCards.js';
import { localizePath } from '../i18n/index.js';
import practicas from '../../public/assets/data/practicas.json';
import beginners from '../../public/assets/data/regular-classes.json';
import improvers from '../../public/assets/data/growth-sessions.json';
import { regularClasses } from '../data/courses.js';

interface Props {
  locale?: 'en' | 'de';
}
const { locale = 'en' } = Astro.props;
const l = (path: string) => localizePath(path, locale);

const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat(locale === 'de' ? 'de-DE' : 'en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${iso}T00:00:00Z`));

const today = new Date().toISOString().slice(0, 10);
// The Tango Garden pin on Google Maps (same link as in the confirmation emails).
// A plain link: nothing loads from Google until someone taps it.
const MAPS_URL = regularClasses.mapsUrl;
// Upcoming at build time; a small script hides any that pass before the next build.
const nextPracticas = practicas.events.filter((e) => e.date >= today).slice(0, 4);
const beginnersStart = beginners.events.find((e) => e.date >= today) ?? beginners.events[0];
const improversStart = improvers.events.find((e) => e.date >= today) ?? improvers.events[0];

const texts = {
  en: {
    title: "You've Got Tango | Tango Garden",
    description:
      'Someone gave you tango. Find out what your Tango Garden gift card includes, how long it lasts and how to come for your first visit.',
    h1: 'A little tango for you',
    sub: "Someone thought you'd enjoy a little more dancing in your life.",
    choose: 'Which gift did you get?',
    chooseHint: 'Tap the one that matches your pass.',
    included: "What's included",
    timeTitle: 'When your pass starts',
    time: (weeks: number, kind: string, visits: number) =>
      `You have up to ${YEARS_TO_START} years to use your gift for the first time. Your first visit starts the pass: ${
        kind === 'classes'
          ? `your ${visits} classes then run on ${visits} Thursdays in a row`
          : `from then on you have ${weeks} weeks for your ${visits} practicas`
      }. If we cancel a date, the validity period is extended accordingly.`,
    datesPractica: 'Next practicas',
    datesClasses: 'Next classes',
    courseLines: [
      `Beginners: from ${fmtDate(beginnersStart.date)}, ${beginnersStart.time}`,
      `Improvers: from ${fmtDate(improversStart.date)}, ${improversStart.time}`,
    ],
    courseNote: 'Thursdays, one class a week. New to tango? Start with the beginners.',
    practicaTime: (time: string) => time,
    allDates: '🗓️ All practica dates',
    allCourse: '🌿 About the classes',
    bring: 'Bring your pass to your first visit.',
    start: '💬 Tell us you are coming',
    expectTitle: 'Good to know',
    expect: [
      'No partner and no experience needed. Most people come alone.',
      'Classes are taught in English.',
      'Wear comfortable clothes. Clean socks or indoor shoes that turn easily; no thick rubber soles.',
      'Arrive 10 minutes early to settle in.',
    ],
    where: 'Thürmchenswall 21, 50668 Cologne (Yoga Drop Studio), 3 minutes from Ebertplatz.',
    directions: '📍 Directions',
    another: '🎁 Another gift',
  },
  de: {
    title: 'Du hast Tango geschenkt bekommen | Tango Garden',
    description:
      'Jemand hat dir Tango geschenkt. Hier siehst du, was dein Tango-Garden-Gutschein enthält, wie lange er gilt und wie du zum ersten Mal kommst.',
    h1: 'Ein bisschen Tango für dich',
    sub: 'Jemand dachte, ein bisschen mehr Tanz würde dir guttun.',
    choose: 'Welchen Gutschein hast du bekommen?',
    chooseHint: 'Tipp auf den, der zu deinem Pass passt.',
    included: 'Das ist drin',
    timeTitle: 'Wann dein Pass startet',
    time: (weeks: number, kind: string, visits: number) =>
      `Du hast bis zu ${YEARS_TO_START} Jahre Zeit, dein Geschenk zum ersten Mal einzulösen. Dein erster Besuch startet den Pass: ${
        kind === 'classes'
          ? `deine ${visits} Stunden finden dann an ${visits} Donnerstagen hintereinander statt`
          : `ab dann hast du ${weeks} Wochen Zeit für deine ${visits} Practicas`
      }. Fällt ein Termin bei uns aus, verlängert sich die Gültigkeit entsprechend.`,
    datesPractica: 'Nächste Practicas',
    datesClasses: 'Nächste Kurse',
    courseLines: [
      `Anfänger:innen: ab ${fmtDate(beginnersStart.date)}, ${beginnersStart.time} Uhr`,
      `Fortgeschrittene: ab ${fmtDate(improversStart.date)}, ${improversStart.time} Uhr`,
    ],
    courseNote: 'Donnerstags, eine Stunde pro Woche. Neu im Tango? Starte bei den Anfänger:innen.',
    practicaTime: (time: string) => `${time} Uhr`,
    allDates: '🗓️ Alle Practica-Termine',
    allCourse: '🌿 Mehr zu den Kursen',
    bring: 'Bring deinen Pass zum ersten Besuch mit.',
    start: '💬 Sag uns, dass du kommst',
    expectTitle: 'Gut zu wissen',
    expect: [
      'Ohne Partner:in und ohne Vorkenntnisse. Die meisten kommen allein.',
      'Unterrichtet wird auf Englisch.',
      'Bequeme Kleidung. Saubere Socken oder Hallenschuhe, mit denen du dich gut drehen kannst; keine dicken Gummisohlen.',
      'Komm 10 Minuten früher, um in Ruhe anzukommen.',
    ],
    where: 'Thürmchenswall 21, 50668 Köln (Yoga Drop Studio), drei Minuten vom Ebertplatz.',
    directions: '📍 Anfahrt',
    another: '🎁 Anderer Gutschein',
  },
};
const text = texts[locale];
---

<BaseLayout title={text.title} description={text.description} canonical={`https://tangogarden.de${l('/pages/you-ve-got-tango')}`} noindex>
  <section class="gc-paper">
    <div class="gc-card">
      <img class="gc-logo" src="/assets/logo-icon.svg" alt="Tango Garden" width="96" height="96" />
      <h1>{text.h1}</h1>
      <p class="gc-sub">{text.sub}</p>
      <hr class="gc-line" />

      <div class="gc-choose" id="choose">
        <h2>{text.choose}</h2>
        <p>{text.chooseHint}</p>
        <ul class="gc-vouchers">
          {
            giftCards.map((g) => (
              <li>
                <a class="gc-voucher" href={`#${g.slug}`}>
                  <span class="gc-circle" aria-hidden="true" />
                  <strong>{g[locale].title}</strong>
                  <span>{g[locale].subtitle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        giftCards.map((g) => {
          const t = g[locale];
          return (
            <section class="gc-detail" id={g.slug}>
              <div class="gc-voucher gc-voucher--big">
                <span class="gc-circle" aria-hidden="true" />
                <strong>{t.title}</strong>
                <span>{t.subtitle}</span>
              </div>

              <h3>{text.included}</h3>
              <ul class="gc-list">
                {t.includes.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>

              <h3>{text.timeTitle}</h3>
              <p>{text.time(g.weeks, g.kind, g.visits)}</p>

              {g.kind === 'classes' ? (
                <>
                  <h3>{text.datesClasses}</h3>
                  <ul class="gc-dates">
                    {text.courseLines.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                  <p>{text.courseNote}</p>
                  <p class="gc-actions">
                    <a class="gc-btn" href={l('/pages/classes')}>{text.allCourse}</a>
                  </p>
                </>
              ) : (
                <>
                  <h3>{text.datesPractica}</h3>
                  <ul class="gc-dates">
                    {nextPracticas.map((e) => (
                      <li data-date={e.date}>
                        {fmtDate(e.date)} · {text.practicaTime(e.time)}
                      </li>
                    ))}
                  </ul>
                  <p class="gc-actions">
                    <a class="gc-btn" href={l('/pages/garden-practica')}>{text.allDates}</a>
                  </p>
                </>
              )}

              <p class="gc-bring">{text.bring}</p>
              <a class="btn-whatsapp" href={waLink(t.startMessage)} target="_blank" rel="noopener">
                {text.start}
              </a>

              <h3>{text.expectTitle}</h3>
              <ul class="gc-list">
                {text.expect.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
              <p class="gc-where">{text.where}</p>
              <p class="gc-actions gc-row">
                <a class="gc-btn" href={MAPS_URL} target="_blank" rel="noopener">{text.directions}</a>
                <a class="gc-btn" href="#choose">{text.another}</a>
              </p>
            </section>
          );
        })
      }

    </div>
  </section>
</BaseLayout>

<script>
  // Dates baked in at build time: hide any that have passed since.
  const today = new Date().toISOString().slice(0, 10);
  for (const li of document.querySelectorAll<HTMLElement>('.gc-dates li[data-date]')) {
    if ((li.dataset.date ?? '') < today) li.hidden = true;
  }
</script>

<style>
  /* The printed card: pale yellow-green paper, olive type, centred column. */
  .gc-paper {
    --paper: #ebe4b0;
    --olive: #4e5d22;
    --olive-light: #8a9a2a;
    background: var(--paper);
    padding: 3.5rem 1.25rem 3rem;
  }
  .gc-card {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
    color: var(--olive);
  }
  .gc-logo {
    width: 96px;
    height: 96px;
    margin: 0 auto 2.25rem;
  }
  .gc-card h1 {
    font-size: clamp(2.1rem, 9vw, 3.4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 0.9rem;
  }
  .gc-sub {
    font-size: clamp(1.1rem, 4.5vw, 1.5rem);
    line-height: 1.4;
    max-width: 30ch;
    margin: 0 auto;
  }
  .gc-line {
    width: min(60%, 320px);
    margin: 2.75rem auto;
    border: 0;
    border-top: 2px solid var(--olive);
  }

  .gc-choose h2 {
    font-size: 1.35rem;
    font-weight: 600;
  }
  .gc-choose > p {
    margin: 0.25rem 0 1.5rem;
  }
  .gc-vouchers {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  /* The pass in the envelope: cream card, thin border, olive circle. */
  .gc-voucher {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fdfcf7;
    border: 2px solid #b9b293;
    border-radius: 10px;
    padding: 1.4rem 1rem 1.25rem;
    text-decoration: none;
    color: var(--olive);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  a.gc-voucher:hover,
  a.gc-voucher:focus-visible {
    transform: translateY(-2px);
    border-color: var(--olive);
  }
  .gc-voucher strong {
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .gc-voucher span:last-child {
    font-size: 1.15rem;
    color: #444;
    margin-top: 0.2rem;
  }
  .gc-circle {
    width: 36px;
    height: 36px;
    border: 3px solid var(--olive-light);
    border-radius: 50%;
    margin-bottom: 0.7rem;
  }

  /* One gift at a time: a detail shows only when its #anchor is in the URL,
     and then the chooser steps aside. */
  .gc-detail {
    display: none;
    text-align: left;
    scroll-margin-top: 90px;
  }
  .gc-detail:target {
    display: block;
  }
  .gc-card:has(.gc-detail:target) .gc-choose {
    display: none;
  }
  .gc-voucher--big {
    margin-bottom: 2rem;
  }
  .gc-detail h3 {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.5rem;
  }
  .gc-detail p,
  .gc-detail li {
    color: #3c4520;
  }
  /* Outline pill buttons, the same as on the gift cards page. */
  /* All buttons centred, in line with the WhatsApp button. */
  .gc-actions {
    margin-top: 1rem;
    text-align: center;
  }
  .gc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 10px 22px;
    border: 1.5px solid var(--olive);
    border-radius: 30px;
    background: #fdfcf7;
    color: var(--olive);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .gc-btn:hover,
  .gc-btn:focus-visible {
    background: #a85a2c;
    border-color: #a85a2c;
    color: #fff;
  }
  .gc-where {
    margin-top: 0.75rem;
  }
  /* Directions and "choose another gift" side by side, wrapping on narrow phones. */
  .gc-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .gc-row .gc-btn {
    padding: 10px 16px;
  }
  .gc-list {
    list-style: none;
  }
  .gc-list li,
  .gc-dates li {
    padding: 0.3rem 0 0.3rem 1.3rem;
    position: relative;
  }
  .gc-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 700;
    color: var(--olive);
  }
  .gc-dates {
    list-style: none;
    margin-bottom: 0.5rem;
  }
  .gc-dates li::before {
    content: '•';
    position: absolute;
    left: 0.3rem;
  }
  .gc-list + p {
    margin-top: 0.75rem;
  }
  .gc-bring {
    margin: 2rem 0 1rem;
    font-weight: 600;
    text-align: center;
  }
  .gc-detail .btn-whatsapp {
    display: flex;
    justify-content: center;
    max-width: 340px;
    margin: 0 auto;
  }
</style>
