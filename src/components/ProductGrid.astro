---
import { products } from '../data/products.js';
import { classPages } from '../data/classPages.js';

// Landing grid for /collections/all. Each class used to expand into a wall of
// per-SKU cards (general admission, student/under-28, 1-class, 4-class...);
// now each class is one consolidated page (src/data/classPages.js) with its
// own pricing/perks table, so this is just 3 cards pointing at those pages.

const priceOf = (handle: string) => {
  const price = products.find((p) => p.handle === handle)?.price ?? '';
  const match = price.match(/€(\d+)/);
  return match ? `€${match[1]}` : price;
};

const rowFor = (slug: string, label: string) =>
  classPages.find((c) => c.slug === slug)!.table.rows.find((r) => r.label === label)!;

const fullCourseRow = rowFor('beginner-course', 'Full Course (12 classes)');
const beginnerCourseRegisterUrl = classPages.find((c) => c.slug === 'beginner-course')?.registerUrl;

const groups = [
  {
    title: 'Enter the Garden',
    blurb: 'One-time, free introductory session for anyone who wants to try without commitment.',
    bestFor: 'anyone curious about tango, zero experience needed.',
    price: priceOf('enter-the-garden-general-admission'),
    href: '/pages/enter-the-garden',
  },
  {
    title: 'The Sprouting Sessions',
    blurb: 'A 12-week beginner course: one class, four classes, or the full course.',
    bestFor: 'complete beginners ready to commit to learning tango.',
    price: `from ${fullCourseRow.perClass?.general}/class`,
    href: '/pages/beginner-course',
    registerUrl: beginnerCourseRegisterUrl,
  },
  {
    title: 'The Garden Practica',
    blurb: 'Open-level guided practice sessions. Drop in whenever you like.',
    bestFor: 'dancers with some experience who want to practice.',
    price: `${priceOf('the-garden-practica-1-practica-pass-general-admission')} or ${priceOf('the-garden-practica-1-practica-pass-door-only-student-and-under-28-admission')}*`,
    href: '/pages/garden-practica',
  },
];
---

<section class="page-hero">
  <h1 class="section-title">Classes &amp; Passes</h1>
  <p class="section-subtitle">
    Every way into the Garden, with current prices. Not sure which fits? Just ask us.
  </p>
</section>

<div class="collection">
  <ul class="collection-list" role="list">
    {
      groups.map((group) => (
        <li>
          <div class="collection-card">
            <span class="collection-card-title">{group.title}</span>
            <span class="collection-card-blurb">{group.blurb}</span>
            <span class="collection-card-best-for"><strong>Best for:</strong> {group.bestFor}</span>
            <span class="collection-card-price">{group.price}</span>
            <div class="collection-card-actions">
              <a class="collection-card-cta" href={group.href}>View details &amp; prices →</a>
              {group.registerUrl && (
                <a class="collection-card-register" href={group.registerUrl} target="_blank" rel="noopener">
                  Register Now
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="collection-why">
    Young people are the future of tango. We keep a reduced rate so the next generation
    can always find their way onto the floor.
  </p>
  <p class="collection-note">
    * Reduced rate for students and anyone 28 and under. No proof needed, we trust you.
  </p>

  <div class="collection-help">
    <h2>Not sure where to start?</h2>
    <p>Tell us where you are and we will point you to the right pass.</p>
    <a
      class="btn-whatsapp"
      href="https://wa.me/491602368723?text=Hi!%20I'm%20not%20sure%20which%20option%20is%20right%20for%20me..."
      target="_blank"
      rel="noopener">💬 Chat on WhatsApp</a
    >
  </div>
</div>

<style>
  .page-hero {
    background: var(--cream);
    padding: 60px 20px 50px;
    text-align: center;
  }
  .collection {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 20px;
  }
  .collection-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 750px) {
    .collection-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .collection-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--cream-light);
    border: 1px solid rgba(78, 93, 34, 0.12);
    border-radius: 14px;
    padding: 24px 22px;
    color: var(--text);
    height: 100%;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .collection-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(45, 80, 22, 0.15);
    border-color: var(--green);
  }
  .collection-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--green);
  }
  .collection-card-blurb {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-light);
  }
  .collection-card-best-for {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-light);
    flex-grow: 1;
  }
  .collection-card-best-for strong {
    color: var(--text);
  }
  .collection-card-price {
    font-weight: 700;
    color: var(--green);
  }
  .collection-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .collection-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid rgba(78, 93, 34, 0.15);
    background: rgba(78, 93, 34, 0.05);
    color: var(--green);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .collection-card-cta:hover {
    background: var(--green);
    color: #efecec;
  }
  .collection-card-register {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 999px;
    background: #c9703e;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .collection-card-register:hover {
    background: #b25f31;
    transform: translateY(-1px);
  }
  .collection-why {
    margin: 40px auto 0;
    max-width: 560px;
    text-align: center;
    color: var(--text);
    line-height: 1.6;
  }
  .collection-note {
    margin-top: 12px;
    text-align: center;
    color: var(--text-light);
    font-size: 0.9rem;
  }
  .collection-help {
    margin-top: 40px;
    padding: 50px 30px;
    background: var(--cream-light);
    border: 1px solid rgba(45, 80, 22, 0.1);
    border-radius: 20px;
    text-align: center;
  }
  .collection-help h2 {
    font-size: 1.4rem;
    color: var(--green);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .collection-help p {
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }
</style>
