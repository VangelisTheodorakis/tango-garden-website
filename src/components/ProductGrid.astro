---
import { products } from '../data/products.js';
import { classPages } from '../data/classPages.js';
import { formatPrice, localizePath } from '../i18n/index.js';

interface Props {
  locale?: 'en' | 'de';
}
const { locale = 'en' } = Astro.props;

// Landing grid for /pages/classes. Each class used to expand into a wall of
// per-SKU cards (general admission, student/under-28, 1-class, 4-class...);
// now each class is one consolidated page (src/data/classPages.js) with its
// own pricing/perks table, so this is just one card per class page.

const priceOf = (handle: string) => {
  const price = products.find((p) => p.handle === handle)?.price ?? '';
  const match = price.match(/€(\d+)/);
  return formatPrice(match ? `€${match[1]}` : price, locale);
};
const fmt = (label: string | undefined) => formatPrice(label ?? '', locale);

const rowFor = (slug: string, label: string) =>
  classPages.find((c) => c.slug === slug)!.table.rows.find((r) => r.label === label)!;

const fullCourseRow = rowFor('beginner-course', 'Full Course (12 classes)');
// Private classes carry plain prices (not Shopify products), read from the same table.
const privatePrice = (label: string) => fmt((rowFor('private-classes', label).general as { price: string }).price);
const beginnerCourseRegisterUrl = classPages.find((c) => c.slug === 'beginner-course')?.registerUrl;
// Same price ladder as the Sprouting Sessions, read from the Growth Sessions table.
const growthRow = rowFor('growth-sessions', 'Full Course (12 classes)');
const growthRegisterUrl = classPages.find((c) => c.slug === 'growth-sessions')?.registerUrl;

const text = {
  en: {
    title: 'Classes & Passes',
    subtitle: 'Every way into the Garden, with current prices.',
    subtitleAsk: 'Not sure which fits? Just ask us.',
    sections: {
      curious: { title: 'For the curious', lead: 'Want to feel what tango is like? No commitment.' },
      determined: { title: 'For the determined', lead: 'Ready to learn and grow, in a group or one-to-one.' },
      everyone: { title: 'For everyone', lead: 'Come and practise together, whenever you like.' },
    },
    bestFor: 'Best for:',
    register: 'Register Now',
    details: 'View details & prices →',
    why: 'Young people are the future of tango. We keep a reduced rate so the next generation can always find their way onto the floor.',
    note: '* Reduced rate for students and anyone 28 and under.',
    helpTitle: 'Not sure where to start?',
    helpBody: 'Tell us where you are and we will point you to the right pass.',
    whatsapp: '💬 Chat on WhatsApp',
    whatsappHref:
      "https://wa.me/491602368723?text=Hi!%20I'm%20not%20sure%20which%20option%20is%20right%20for%20me...",
    groups: [
      {
        title: 'Enter the Garden',
        blurb: 'One-time, free introductory session for anyone who wants to try without commitment.',
        bestFor: 'anyone curious about tango, zero experience needed.',
      },
      {
        title: 'The Sprouting Sessions',
        blurb: 'A 12-week beginner course: one class, four classes, or the full course.',
        bestFor: 'complete beginners ready to commit to learning tango.',
        price: `from ${fullCourseRow.perClass?.general} or ${fullCourseRow.perClass?.student}*/class`,
      },
      {
        title: 'The Growth Sessions',
        blurb: 'A 12-week course for improvers, every Thursday. Free access to all beginner classes with a multi-class pass.',
        bestFor: 'dancers who know the basics and want to grow on the dance floor.',
        price: `from ${growthRow.perClass?.general} or ${growthRow.perClass?.student}*/class`,
      },
      {
        title: 'The Garden Practica',
        blurb: 'Open-level guided practice sessions. Drop in whenever you like.',
        bestFor: 'anyone with at least one tango class who wants to practice.',
      },
      {
        title: 'Private Classes',
        blurb: 'One-to-one with Vangelis or Kristina, on your own or as a couple, at your place, ours or a studio.',
        bestFor: 'anyone who wants a class built around their own goals and pace.',
        price: `${privatePrice('One person')}/hour, or ${privatePrice('Couple')} for a couple`,
      },
    ],
  },
  de: {
    title: 'Kurse & Pässe',
    subtitle: 'Alle Wege in den Garten, mit aktuellen Preisen.',
    subtitleAsk: 'Nicht sicher, was passt? Frag uns einfach.',
    sections: {
      curious: { title: 'Für die Neugierigen', lead: 'Du willst spüren, wie sich Tango anfühlt? Ganz ohne Verpflichtung.' },
      determined: { title: 'Für die Entschlossenen', lead: 'Du willst lernen und wachsen, in der Gruppe oder ganz persönlich.' },
      everyone: { title: 'Für alle', lead: 'Komm zum gemeinsamen Üben vorbei, wann immer du magst.' },
    },
    bestFor: 'Ideal für:',
    register: 'Jetzt anmelden',
    details: 'Details & Preise ansehen →',
    why: 'Junge Menschen sind die Zukunft des Tango. Deshalb gibt es einen ermäßigten Preis, damit die nächste Generation immer ihren Weg auf die Tanzfläche findet.',
    note: '* Ermäßigt für Studierende und alle bis 28 Jahre.',
    helpTitle: 'Nicht sicher, wo du anfangen sollst?',
    helpBody: 'Erzähl uns, wo du gerade stehst, und wir zeigen dir den passenden Pass.',
    whatsapp: '💬 Auf WhatsApp schreiben',
    whatsappHref:
      'https://wa.me/491602368723?text=Hi!%20Ich%20bin%20mir%20nicht%20sicher%2C%20welches%20Angebot%20zu%20mir%20passt...',
    groups: [
      {
        title: 'Enter the Garden',
        blurb: 'Einmalige, kostenlose Probestunde für alle, die ganz unverbindlich reinschnuppern möchten.',
        bestFor: 'Alle, die neugierig auf Tango sind, ganz ohne Erfahrung.',
      },
      {
        title: 'The Sprouting Sessions',
        blurb: 'Ein 12-wöchiger Anfängerkurs: Eine Stunde, vier Stunden oder der ganze Kurs.',
        bestFor: 'Absolute Anfänger:innen, die Tango wirklich lernen wollen.',
        price: `ab ${fmt(fullCourseRow.perClass?.general)} oder ${fmt(fullCourseRow.perClass?.student)}* pro Stunde`,
      },
      {
        title: 'The Growth Sessions',
        blurb: 'Ein 12-wöchiger Kurs für Fortgeschrittene, jeden Donnerstag. Mit einem Mehrfach-Pass kostenlos in allen Anfängerstunden.',
        bestFor: 'Alle mit Tango-Grundlagen, die sich auf der Tanzfläche weiterentwickeln möchten.',
        price: `ab ${fmt(growthRow.perClass?.general)} oder ${fmt(growthRow.perClass?.student)}* pro Stunde`,
      },
      {
        title: 'The Garden Practica',
        blurb: 'Geführte Übungsabende für alle Level. Komm vorbei, wann immer du magst.',
        bestFor: 'Alle mit mindestens einer Tango-Stunde, die üben möchten.',
      },
      {
        title: 'Privatunterricht',
        blurb: 'Ganz persönlich mit Vangelis oder Kristina, allein oder als Paar, bei dir, bei uns oder im Studio.',
        bestFor: 'Alle, die eine Stunde ganz nach ihren eigenen Zielen und ihrem Tempo möchten.',
        price: `${privatePrice('One person')} pro Stunde oder ${privatePrice('Couple')} für ein Paar`,
      },
    ],
  },
}[locale];

const [etg, sprouting, growth, practica, privateClasses] = text.groups;
type Group = { title: string; blurb: string; bestFor: string; price: string; href: string; registerUrl?: string };
const [etgCard, sproutingCard, growthCard, practicaCard, privateCard]: Group[] = [
  {
    ...etg,
    price: priceOf('enter-the-garden-general-admission'),
    href: localizePath('/pages/enter-the-garden', locale),
  },
  {
    ...sprouting,
    price: sprouting.price!,
    href: localizePath('/pages/beginner-course', locale),
    registerUrl: beginnerCourseRegisterUrl,
  },
  {
    ...growth,
    price: growth.price!,
    href: localizePath('/pages/growth-sessions', locale),
    registerUrl: growthRegisterUrl,
  },
  {
    ...practica,
    price: `${priceOf('the-garden-practica-1-practica-pass-general-admission')} ${locale === 'de' ? 'oder' : 'or'} ${priceOf('the-garden-practica-1-practica-pass-door-only-student-and-under-28-admission')}*`,
    href: localizePath('/pages/garden-practica', locale),
  },
  {
    ...privateClasses,
    price: privateClasses.price!,
    href: localizePath('/pages/private-classes', locale),
  },
];

// Three sections by intent. The determined ones fill the first row; the curious
// and everyone share the second.
const section = (key: keyof typeof text.sections, cards: Group[]) => ({ key, cards, ...text.sections[key] });
const rows = [
  [section('determined', [sproutingCard, growthCard, privateCard])],
  [section('curious', [etgCard]), section('everyone', [practicaCard])],
];
---

<section class="page-hero">
  <h1 class="section-title">{text.title}</h1>
  <p class="section-subtitle">
    {text.subtitle}<br />
    {text.subtitleAsk}
  </p>
</section>

<div class="collection">
  {
    rows.map((row) => (
      <div class:list={['collection-row', { 'is-pair': row.length > 1 }]}>
        {row.map((section) => (
        <section class="collection-section">
          <h2 class="collection-section-title">{section.title}</h2>
          <p class="collection-section-lead">{section.lead}</p>
          <ul class:list={['collection-list', { 'is-single': section.cards.length === 1 }]} role="list">
          {
              section.cards.map((group) => (
              <li>
                <div class="collection-card">
                  <span class="collection-card-title">{group.title}</span>
                  <span class="collection-card-blurb">{group.blurb}</span>
                  <span class="collection-card-best-for"><strong>{text.bestFor}</strong> {group.bestFor}</span>
                  <span class="collection-card-price">{group.price}</span>
                  <div class="collection-card-actions">
                    {group.registerUrl ? (
                      <a class="collection-card-register" href={group.registerUrl} target="_blank" rel="noopener">
                        {text.register}
                      </a>
                    ) : (
                      // Invisible same-size placeholder so cards without a register
                      // button still reserve its row, keeping the green CTA on the
                      // same horizontal line across all three cards.
                      <span class="collection-card-register is-spacer" aria-hidden="true">{text.register}</span>
                    )}
                    <a class="collection-card-cta" href={group.href}>{text.details}</a>
                  </div>
                </div>
              </li>
            ))
          }
          </ul>
        </section>
        ))}
      </div>
    ))
  }

  <p class="collection-why">
    {text.why}
  </p>
  <p class="collection-note">
    {text.note}
  </p>

  <div class="collection-help">
    <h2>{text.helpTitle}</h2>
    <p>{text.helpBody}</p>
    <a
      class="btn-whatsapp"
      href={text.whatsappHref}
      target="_blank"
      rel="noopener">{text.whatsapp}</a
    >
  </div>
</div>

<style>
  .page-hero {
    background: var(--cream);
    padding: 60px 20px 50px;
    text-align: center;
  }
  .collection {
    max-width: 1140px;
    margin: 0 auto;
    padding: 60px 20px;
  }
  .collection-row + .collection-row {
    margin-top: 48px;
  }
  .collection-row.is-pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  @media (min-width: 750px) {
    /* Two sections side by side, each as wide as one card of the row above. */
    .collection-row.is-pair {
      grid-template-columns: repeat(2, calc((100% - 48px) / 3));
      justify-content: center;
      gap: 24px;
    }
    .collection-row.is-pair .collection-list.is-single {
      grid-template-columns: 1fr;
    }
  }
  .collection-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--green);
    text-align: center;
  }
  .collection-section-lead {
    margin: 4px 0 20px;
    text-align: center;
    color: var(--text-light);
  }
  .collection-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  /* Three columns, the width of the widest section; a section with one card
     shows it centred at the same card width. */
  @media (min-width: 750px) {
    .collection-list {
      grid-template-columns: repeat(3, 1fr);
    }
    .collection-list.is-single {
      grid-template-columns: calc((100% - 48px) / 3);
      justify-content: center;
    }
  }
  .collection-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--cream-light);
    border: 1px solid rgba(78, 93, 34, 0.12);
    border-radius: 14px;
    padding: 28px 26px;
    color: var(--text);
    height: 100%;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .collection-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(45, 80, 22, 0.15);
    border-color: var(--green);
  }
  .collection-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--green);
  }
  .collection-card-blurb {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-light);
  }
  .collection-card-best-for {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-light);
    flex-grow: 1;
  }
  .collection-card-best-for strong {
    color: var(--text);
  }
  .collection-card-price {
    font-weight: 700;
    color: var(--green);
  }
  .collection-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .collection-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--green);
    background: var(--green);
    color: #efecec;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .collection-card-cta:hover {
    background: var(--green-btn);
    border-color: var(--green-btn);
    transform: translateY(-1px);
  }
  .collection-card-register {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 999px;
    background: #c9703e;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .collection-card-register:hover {
    background: #b25f31;
    transform: translateY(-1px);
  }
  .collection-card-register.is-spacer {
    visibility: hidden;
    pointer-events: none;
  }
  .collection-why {
    margin: 40px auto 0;
    max-width: 560px;
    text-align: center;
    color: var(--text);
    line-height: 1.6;
  }
  .collection-note {
    margin-top: 12px;
    text-align: center;
    color: var(--text-light);
    font-size: 0.9rem;
  }
  .collection-help {
    margin-top: 40px;
    padding: 50px 30px;
    background: var(--cream-light);
    border: 1px solid rgba(45, 80, 22, 0.1);
    border-radius: 20px;
    text-align: center;
  }
  .collection-help h2 {
    font-size: 1.4rem;
    color: var(--green);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .collection-help p {
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }
</style>
