---
/**
 * Emits JSON-LD. `type="localbusiness"` renders the site-wide LocalBusiness
 * entity (homepage only); `type="product"` renders a Product/Offer for a PDP;
 * `type="learningresource"` renders a LearningResource for an interactive
 * teaching tool (e.g. the rhythm trainer).
 */
interface ProductInfo {
  name: string;
  description: string;
  url: string;
  price: string;
  availability: 'InStock' | 'OutOfStock';
}

interface LearningResourceInfo {
  name: string;
  description: string;
  url: string;
  teaches: string[];
}

interface Props {
  type?: 'localbusiness' | 'product' | 'learningresource' | 'none';
  product?: ProductInfo;
  learningResource?: LearningResourceInfo;
}

const { type = 'none', product, learningResource } = Astro.props;

const business = {
  name: 'Tango Garden Cologne',
  url: 'https://tangogarden.de',
  sameAs: [
    'https://www.instagram.com/tangogardencologne',
    'https://www.facebook.com/tangogardencologne/',
  ],
};

const address = {
  '@type': 'PostalAddress',
  streetAddress: 'Thürmchenswall 21',
  postalCode: '50668',
  addressLocality: 'Köln',
  addressRegion: 'NRW',
  addressCountry: 'DE',
};

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'SportsActivityLocation'],
  '@id': 'https://tangogarden.de/#localbusiness',
  ...business,
  image: 'https://tangogarden.de/images/og-image.jpg',
  telephone: '+49 160 2368723',
  email: 'hello@tangogarden.de',
  priceRange: '€€',
  currenciesAccepted: 'EUR',
  address,
  geo: { '@type': 'GeoCoordinates', latitude: 50.9501585, longitude: 6.9535692 },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '19:30', closes: '21:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '19:30', closes: '22:00' },
  ],
};

const productSchema = product && {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  url: product.url,
  brand: { '@type': 'Organization', name: 'Tango Garden Cologne' },
  offers: {
    '@type': 'Offer',
    url: product.url,
    price: product.price,
    priceCurrency: 'EUR',
    availability: `https://schema.org/${product.availability}`,
  },
};

const learningResourceSchema = learningResource && {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: learningResource.name,
  description: learningResource.description,
  url: learningResource.url,
  inLanguage: 'en',
  isAccessibleForFree: true,
  learningResourceType: 'Interactive Resource',
  teaches: learningResource.teaches,
  provider: { '@type': 'Organization', name: 'Tango Garden Cologne', url: 'https://tangogarden.de' },
};

const schema =
  type === 'localbusiness'
    ? localBusiness
    : type === 'product'
      ? productSchema
      : type === 'learningresource'
        ? learningResourceSchema
        : null;
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
