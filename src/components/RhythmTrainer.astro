---
/**
 * The rhythm trainer, shared by /pages/tango-rhythm-trainer, its German
 * mirror, the tango vals variant (`mode="vals"`, 3/4) and the milonga variant
 * (`mode="milonga"`, 2/4 in sixteenths). Words come from `text` below and
 * rhythmExercises.de.js; the audio engine in the script is language- and
 * meter-neutral: the catalogue decides how many slots there are and how many
 * of them make a beat.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  exercises as exercisesEn,
  orchestraTempos,
  glossary as glossaryEn,
  SLOTS,
  slotStrength,
  slotLabel,
} from '../data/rhythmExercises.js';
import * as valsData from '../data/rhythmExercises.vals.js';
import * as milongaData from '../data/rhythmExercises.milonga.js';
import {
  localizeExercises,
  localizeGlossary,
  exercisesValsDe,
  glossaryValsDe,
  exercisesMilongaDe,
  glossaryMilongaDe,
} from '../data/rhythmExercises.de.js';
import { absoluteUrl, localizePath } from '../i18n/index.js';

interface Props {
  locale?: 'en' | 'de';
  mode?: 'tango' | 'vals' | 'milonga';
  /** Keeps a draft page out of search results (and, via noindex.js, the sitemap). */
  noindex?: boolean;
}
const { locale = 'en', mode = 'tango', noindex = false } = Astro.props;
const de = locale === 'de';
const vals = mode === 'vals';

// What differs between the trainers besides words: the catalogue, the number
// of slots and beats, how many slots make a beat, the tempo slider, and the
// reset target.
const config = {
  tango: {
    exercises: exercisesEn,
    glossary: glossaryEn,
    exercisesDe: undefined,
    glossaryDe: undefined,
    slots: SLOTS,
    beats: 4,
    slotsPerBeat: 2,
    strength: slotStrength,
    label: slotLabel,
    orchestras: orchestraTempos,
    tempo: { min: 60, max: 140, value: 100 },
    defaultId: 'marcato-2',
    path: '/pages/tango-rhythm-trainer',
  },
  vals: {
    exercises: valsData.exercises,
    glossary: valsData.glossary,
    exercisesDe: exercisesValsDe,
    glossaryDe: glossaryValsDe,
    slots: valsData.SLOTS,
    beats: 3,
    slotsPerBeat: 1,
    strength: valsData.slotStrength,
    label: valsData.slotLabel,
    orchestras: valsData.orchestraTempos,
    tempo: valsData.tempo,
    defaultId: valsData.DEFAULT_EXERCISE,
    path: '/pages/tango-vals-rhythm-trainer',
  },
  milonga: {
    exercises: milongaData.exercises,
    glossary: milongaData.glossary,
    exercisesDe: exercisesMilongaDe,
    glossaryDe: glossaryMilongaDe,
    slots: milongaData.SLOTS,
    beats: 2,
    slotsPerBeat: milongaData.SLOTS_PER_BEAT,
    strength: milongaData.slotStrength,
    label: milongaData.slotLabel,
    orchestras: milongaData.orchestraTempos,
    tempo: milongaData.tempo,
    defaultId: milongaData.DEFAULT_EXERCISE,
    path: '/pages/milonga-rhythm-trainer',
  },
}[mode];

const exercises = de ? localizeExercises(config.exercises, config.exercisesDe) : config.exercises;
const glossary = de ? localizeGlossary(config.glossary, config.glossaryDe) : config.glossary;
const url = absoluteUrl(localizePath(config.path, locale));

const tangoText = {
  en: {
    title: 'Tango Rhythm Trainer | Tango Garden',
    description:
      'A free, browser-based rhythm trainer for tango dancers: practise marcato, síncopa, contratiempo and tresillo, tap beats on and off, play at your tempo.',
    schemaName: 'Tango Rhythm Trainer',
    schemaDescription:
      'An interactive, browser-based tool for practising the core rhythmic patterns of Golden Age tango: marcato, síncopa, contratiempo, tresillo and more.',
    h1: 'Tango Rhythm Trainer',
    intro:
      'A free, browser-based tango rhythm trainer: practise marcato, síncopa, contratiempo, tresillo and more of the rhythmic vocabulary behind Golden Age tango. Two compases, counted <strong>1 to 8</strong> with an <strong>&amp;</strong> between each beat. Dark bars sound; tap any bar to switch it on or off. Tall bars are the strong beats, short bars the offbeats.',
    start: 'Start',
    reset: 'Reset to Marcato 2',
    tempo: 'Tempo',
    exercise: 'Exercise',
    yourOwn: 'Your own',
    pulse: 'Hear the pulse',
    orchestras: 'Match a Golden Age orchestra:',
    count: 'Count',
    hint: 'Sound only starts when you press Start. Nothing plays before that.',
    nextSteps: 'Take it further',
    practiseTitle: 'Come practise with us',
    practiseBody:
      'You just drilled it. Now bring it to the floor: real music, real partners, no partner needed to join.',
    practiseCta: 'See Practica times',
    ideaTitle: 'Got an idea for an exercise?',
    ideaBody:
      "Feedback, corrections, or a pattern you'd like to see added: tell us on the contact page.",
    ideaCta: 'Contact us',
    glossary: 'Rhythm vocabulary',
  },
  de: {
    title: 'Tango-Rhythmustrainer: Musikalität üben | Tango Garden',
    description:
      'Kostenloser Rhythmustrainer für Tango im Browser: Übe Marcato, Síncopa, Contratiempo und Tresillo, schalte Schläge an und aus und spiel in deinem Tempo.',
    schemaName: 'Tango-Rhythmustrainer',
    schemaDescription:
      'Ein interaktives Tool im Browser, um die rhythmischen Grundmuster des Golden-Age-Tango zu üben: Marcato, Síncopa, Contratiempo, Tresillo und mehr.',
    h1: 'Tango-Rhythmustrainer',
    intro:
      'Ein kostenloser Tango-Rhythmustrainer im Browser: Übe Marcato, Síncopa, Contratiempo, Tresillo und mehr aus dem rhythmischen Vokabular des Golden-Age-Tango. Zwei Compases, gezählt <strong>1 bis 8</strong> mit einem <strong>&amp;</strong> zwischen den Schlägen. Dunkle Balken klingen; tippe auf einen Balken, um ihn an- oder auszuschalten. Hohe Balken sind die starken Schläge, kurze die Offbeats.',
    start: 'Start',
    reset: 'Zurück zu Marcato 2',
    tempo: 'Tempo',
    exercise: 'Übung',
    yourOwn: 'Eigenes Muster',
    pulse: 'Puls hören',
    orchestras: 'Tempo eines Golden-Age-Orchesters:',
    count: 'Zählzeit',
    hint: 'Der Sound startet erst, wenn du auf Start drückst. Vorher wird nichts abgespielt.',
    nextSteps: 'Mach weiter',
    practiseTitle: 'Üb mit uns',
    practiseBody:
      'Du hast es gerade geübt. Jetzt bring es auf die Tanzfläche: echte Musik, echte Menschen, und du brauchst keine:n Partner:in, um mitzumachen.',
    practiseCta: 'Practica-Termine ansehen',
    ideaTitle: 'Du hast eine Idee für eine Übung?',
    ideaBody:
      'Feedback, Korrekturen oder ein Muster, das du gerne hier sehen würdest: Sag es uns auf der Kontaktseite.',
    ideaCta: 'Kontakt',
    glossary: 'Rhythmus-Vokabular',
  },
}[locale];

// Only the words that change for vals; everything else (buttons, hint, the
// "take it further" cards, the glossary heading) is shared with the tango page.
const valsText = {
  en: {
    title: 'Tango Vals Rhythm Trainer | Tango Garden',
    description:
      'A free, browser-based rhythm trainer for tango vals: practise the base rhythm on beat 1, the 1-2 and 3-1 doubles and all three beats, at your own tempo.',
    schemaName: 'Tango Vals Rhythm Trainer',
    schemaDescription:
      'An interactive, browser-based tool for practising the rhythms dancers use in tango vals: the base rhythm on beat 1, the 1-2 and 3-1 doubles, and all three beats.',
    h1: 'Tango Vals Rhythm Trainer',
    intro:
      'A free, browser-based rhythm trainer for tango vals: practise the base rhythm on beat 1, the 1-2 and 3-1 doubles, and all three beats. Two compases of three beats, counted <strong>1 2 3</strong>. Dark bars sound; tap any bar to switch it on or off. The tall bar is the accented first beat, the shorter bars are beats 2 and 3.',
    reset: 'Reset to beat 1 only',
    bars: 'compases/min',
  },
  de: {
    title: 'Tango-Vals-Rhythmustrainer: Musikalität üben | Tango Garden',
    description:
      'Kostenloser Rhythmustrainer für Tango Vals im Browser: Übe den Grundrhythmus auf der 1, die Verdopplungen 1-2 und 3-1 und alle drei Schläge, in deinem Tempo.',
    schemaName: 'Tango-Vals-Rhythmustrainer',
    schemaDescription:
      'Ein interaktives Tool im Browser, um die Rhythmen zu üben, die im Tango Vals getanzt werden: den Grundrhythmus auf der 1, die Verdopplungen 1-2 und 3-1 und alle drei Schläge.',
    h1: 'Tango-Vals-Rhythmustrainer',
    intro:
      'Ein kostenloser Rhythmustrainer für Tango Vals im Browser: Übe den Grundrhythmus auf der 1, die Verdopplungen 1-2 und 3-1 und alle drei Schläge. Zwei Compases mit je drei Schlägen, gezählt <strong>1 2 3</strong>. Dunkle Balken klingen; tippe auf einen Balken, um ihn an- oder auszuschalten. Der hohe Balken ist der betonte erste Schlag, die kürzeren sind die Schläge 2 und 3.',
    reset: 'Zurück zu „Nur die 1“',
    bars: 'Compases/Min.',
  },
}[locale];

const milongaText = {
  en: {
    title: 'Milonga Rhythm Trainer | Tango Garden',
    description:
      'A free, browser-based rhythm trainer for milonga: practise dancing a tiempo, the double beat, the habanera and traspié, at your own tempo.',
    schemaName: 'Milonga Rhythm Trainer',
    schemaDescription:
      'An interactive, browser-based tool for practising the rhythms of milonga: stepping a tiempo, the double beat, the habanera pattern and the variants of traspié.',
    h1: 'Milonga Rhythm Trainer',
    intro:
      'A free, browser-based rhythm trainer for milonga: practise dancing a tiempo, the double beat, the habanera and traspié. Two compases of two beats, counted <strong>1 y 2 y</strong>, with a dot for the sixteenths in between. Dark bars sound; tap any bar to switch it on or off. The tall bar is beat 1, the medium bar beat 2, short bars everything between.',
    reset: 'Reset to both beats',
  },
  de: {
    title: 'Milonga-Rhythmustrainer: Musikalität üben | Tango Garden',
    description:
      'Kostenloser Rhythmustrainer für Milonga im Browser: Übe a tiempo, den doppelten Schlag, die Habanera und Traspié, in deinem Tempo.',
    schemaName: 'Milonga-Rhythmustrainer',
    schemaDescription:
      'Ein interaktives Tool im Browser, um die Rhythmen der Milonga zu üben: a tiempo gehen, den doppelten Schlag, das Habanera-Muster und die Varianten des Traspié.',
    h1: 'Milonga-Rhythmustrainer',
    intro:
      'Ein kostenloser Rhythmustrainer für Milonga im Browser: Übe a tiempo, den doppelten Schlag, die Habanera und Traspié. Zwei Compases mit je zwei Schlägen, gezählt <strong>1 y 2 y</strong>, mit einem Punkt für die Sechzehntel dazwischen. Dunkle Balken klingen; tippe auf einen Balken, um ihn an- oder auszuschalten. Der hohe Balken ist Schlag 1, der mittlere Schlag 2, kurze Balken alles dazwischen.',
    reset: 'Zurück zu „Beide Schläge“',
  },
}[locale];

const text = { tango: tangoText, vals: { ...tangoText, ...valsText }, milonga: { ...tangoText, ...milongaText } }[mode];

const slots = Array.from({ length: config.slots }, (_, i) => ({
  i,
  strength: config.strength(i),
  label: config.label(i),
}));

/** The readout next to the slider. Vals also shows compases per minute, the unit teachers quote. */
const formatTempo = (bpm: number) =>
  vals ? `${bpm} BPM · ${Math.round(bpm / 3)} ${valsText.bars}` : `${bpm} BPM`;
---

<BaseLayout
  title={text.title}
  description={text.description}
  canonical={url}
  noindex={noindex}
  schema="learningresource"
  learningResource={{
    name: text.schemaName,
    description: text.schemaDescription,
    url,
    teaches: glossary.map((g) => g.term),
    inLanguage: locale,
  }}
>
  <div class="rhythm-page">
    <h1 class="rhythm-title">{text.h1}</h1>
    <p class="rhythm-intro" set:html={text.intro} />

    <div class="rhythm-controls">
      <button type="button" id="rhythm-play" class="rhythm-play" aria-pressed="false">
        <span class="rhythm-play-label">{text.start}</span>
      </button>

      <button type="button" id="rhythm-reset" class="rhythm-reset">
        {text.reset}
      </button>

      <div class="rhythm-tempo" data-wrap={vals ? '' : undefined}>
        <label for="rhythm-bpm">{text.tempo}</label>
        <input
          type="range"
          id="rhythm-bpm"
          min={config.tempo.min}
          max={config.tempo.max}
          step="1"
          value={config.tempo.value}
        />
        <output for="rhythm-bpm" id="rhythm-bpm-out">{formatTempo(config.tempo.value)}</output>
      </div>

      <div class="rhythm-preset">
        <label for="rhythm-exercise">{text.exercise}</label>
        <select id="rhythm-exercise">
          {exercises.map((e) => (
            <option value={e.id} selected={e.id === config.defaultId}>
              {e.name}
            </option>
          ))}
          <option value="custom" hidden>{text.yourOwn}</option>
        </select>
      </div>

      <label class="rhythm-pulse">
        <input type="checkbox" id="rhythm-pulse" />
        <span>{text.pulse}</span>
      </label>
    </div>

    {
      config.orchestras.length > 0 && (
        <div class="rhythm-orchestras">
          <span class="rhythm-orchestras-label">{text.orchestras}</span>
          <div class="rhythm-orchestra-list">
            {config.orchestras.map((o) => (
              <button type="button" class="rhythm-orchestra-btn" data-bpm={o.bpm}>
                {o.name} <span>{o.bpm} BPM</span>
              </button>
            ))}
          </div>
        </div>
      )
    }

    <p class="rhythm-note" id="rhythm-note"></p>

    <div
      class="rhythm-grid"
      id="rhythm-grid"
      data-mode={mode}
      data-beats={config.beats}
      data-slots-per-beat={config.slotsPerBeat}
    >
      {
        slots.map((s) => (
          <div class="rhythm-slot">
            <button
              type="button"
              class="rhythm-bar"
              data-slot={s.i}
              data-strength={s.strength}
              aria-pressed="false"
            >
              <span class="visually-hidden">{text.count} {s.label}</span>
            </button>
            <span class="rhythm-count" aria-hidden="true">{s.label}</span>
          </div>
        ))
      }
    </div>

    <p class="rhythm-hint">{text.hint}</p>

    <audio id="rhythm-audio" playsinline preload="auto" class="visually-hidden"></audio>

    <section class="rhythm-next-steps" aria-labelledby="rhythm-next-steps-heading">
      <h2 id="rhythm-next-steps-heading">{text.nextSteps}</h2>
      <div class="rhythm-next-steps-cards">
        <div class="rhythm-next-steps-card">
          <p class="rhythm-next-steps-title">{text.practiseTitle}</p>
          <p>{text.practiseBody}</p>
          <a class="btn-register" href={localizePath('/pages/garden-practica', locale)}>{text.practiseCta}</a>
        </div>
        <div class="rhythm-next-steps-card">
          <p class="rhythm-next-steps-title">{text.ideaTitle}</p>
          <p>{text.ideaBody}</p>
          <a class="btn-secondary" href={localizePath('/pages/contact', locale)}>{text.ideaCta}</a>
        </div>
      </div>
    </section>

    <section class="rhythm-glossary" aria-labelledby="rhythm-glossary-heading">
      <h2 id="rhythm-glossary-heading">{text.glossary}</h2>
      <dl>
        {
          glossary.map((g) => (
            <div class="rhythm-glossary-entry">
              <dt>
                {g.term}
                {g.spanish && <span class="rhythm-glossary-spanish">{g.spanish}</span>}
              </dt>
              <dd>{g.definition}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <script>
    import { exercises as tangoExercises, SLOTS as TANGO_SLOTS } from '../data/rhythmExercises.js';
    import {
      exercises as valsExercises,
      SLOTS as VALS_SLOTS,
      DEFAULT_EXERCISE as VALS_DEFAULT,
    } from '../data/rhythmExercises.vals.js';
    import {
      exercises as milongaExercises,
      SLOTS as MILONGA_SLOTS,
      DEFAULT_EXERCISE as MILONGA_DEFAULT,
    } from '../data/rhythmExercises.milonga.js';
    import {
      localizeExercises,
      exercisesValsDe,
      exercisesMilongaDe,
    } from '../data/rhythmExercises.de.js';

    const de = document.documentElement.lang === 'de';
    const labels = de
      ? { stop: 'Stopp', start: 'Start', ownName: 'Eigenes Muster', ownNote: 'Dein eigenes Muster.', artist: 'Tango Garden Rhythmustrainer', bars: 'Compases/Min.' }
      : { stop: 'Stop', start: 'Start', ownName: 'Your own pattern', ownNote: 'Your own pattern.', artist: 'Tango Garden Rhythm Trainer', bars: 'compases/min' };

    type Voice = 'beat' | 'pulse';

    const grid = document.getElementById('rhythm-grid');
    // The page tells us which catalogue it was rendered for (see RhythmTrainer
    // frontmatter); the engine below is otherwise identical for both.
    const mode = grid?.dataset.mode ?? 'tango';
    const vals = mode === 'vals';
    const catalogue =
      mode === 'vals'
        ? { list: valsExercises, de: exercisesValsDe, slots: VALS_SLOTS, defaultId: VALS_DEFAULT }
        : mode === 'milonga'
          ? { list: milongaExercises, de: exercisesMilongaDe, slots: MILONGA_SLOTS, defaultId: MILONGA_DEFAULT }
          : { list: tangoExercises, de: undefined, slots: TANGO_SLOTS, defaultId: 'marcato-2' };
    const SLOTS = catalogue.slots;
    const DEFAULT_ID = catalogue.defaultId;
    /** Slots in one beat: 2 where a slot is an eighth, 4 where it is a sixteenth (milonga). */
    const SLOTS_PER_BEAT = Number(grid?.dataset.slotsPerBeat ?? 2);
    const exercises = de ? localizeExercises(catalogue.list, catalogue.de) : catalogue.list;
    if (grid) {
      const playBtn = document.querySelector<HTMLButtonElement>('#rhythm-play')!;
      const playLabel = playBtn.querySelector<HTMLSpanElement>('.rhythm-play-label')!;
      const resetBtn = document.querySelector<HTMLButtonElement>('#rhythm-reset')!;
      const bpmInput = document.querySelector<HTMLInputElement>('#rhythm-bpm')!;
      const bpmOut = document.querySelector<HTMLOutputElement>('#rhythm-bpm-out')!;
      const select = document.querySelector<HTMLSelectElement>('#rhythm-exercise')!;
      const pulseInput = document.querySelector<HTMLInputElement>('#rhythm-pulse')!;
      const noteEl = document.querySelector<HTMLParagraphElement>('#rhythm-note')!;
      const bars = [...grid.querySelectorAll<HTMLButtonElement>('.rhythm-bar')];
      const player = document.querySelector<HTMLAudioElement>('#rhythm-audio')!;

      /** Which slots sound. Index 0–15. */
      const active: boolean[] = new Array(SLOTS).fill(false);
      let currentName = DEFAULT_ID;

      // --- pattern <-> UI ---------------------------------------------------

      function paint() {
        bars.forEach((b, i) => b.setAttribute('aria-pressed', String(active[i])));
      }

      function load(id: string) {
        const ex = exercises.find((e) => e.id === id);
        if (!ex) return;
        for (let i = 0; i < SLOTS; i++) active[i] = ex.pattern[i] === 'x';
        currentName = ex.name;
        noteEl.textContent = ex.spanish ? `${ex.spanish}: ${ex.note}` : ex.note;
        paint();
      }

      // --- audio --------------------------------------------------------------
      // The loop is rendered up front as one exact repeat and handed to a native
      // <audio> element with `loop` set, instead of scheduling clicks from JS as
      // the loop plays. A real media element keeps looping on the device's own
      // media pipeline once started, so it survives the screen locking or the
      // browser going to the background — a live-scheduled Web Audio graph does
      // not, since the timers that feed it get suspended right along with the
      // page. That's what lets a dancer run this hands-free with the phone in a
      // pocket.

      /** One click for every active note, whatever its bar height; the pulse is a quieter, lower reference tick. */
      const VOICE: Record<Voice, { freq: number; gain: number }> = {
        beat: { freq: 1100, gain: 0.75 },
        pulse: { freq: 520, gain: 0.1 },
      };

      /** One slot in seconds: a beat divided by however many slots it holds. */
      const slotSeconds = () => 60 / Number(bpmInput.value) / SLOTS_PER_BEAT;

      function click(ctx: BaseAudioContext, kind: Voice, time: number) {
        const { freq, gain } = VOICE[kind];
        const osc = ctx.createOscillator();
        const amp = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, time);
        // A short percussive envelope: no click at the edges, no ringing tail.
        amp.gain.setValueAtTime(0.0001, time);
        amp.gain.exponentialRampToValueAtTime(gain, time + 0.004);
        amp.gain.exponentialRampToValueAtTime(0.0001, time + 0.06);
        osc.connect(amp).connect(ctx.destination);
        osc.start(time);
        osc.stop(time + 0.08);
      }

      /**
       * Encode a rendered buffer as a 16-bit PCM WAV Blob (self-hosted, no
       * library), with the audio repeated `repeats` times back to back. The
       * repeats are a straight copy of the first, which is far cheaper than
       * asking Web Audio to render the same clicks again.
       */
      function encodeWav(buffer: AudioBuffer, repeats = 1): Blob {
        const channels = buffer.numberOfChannels;
        const rate = buffer.sampleRate;
        const frames = buffer.length;
        const blockAlign = channels * 2;
        const onceSize = frames * blockAlign;
        const dataSize = onceSize * repeats;
        const view = new DataView(new ArrayBuffer(44 + dataSize));

        const writeString = (offset: number, s: string) => {
          for (let i = 0; i < s.length; i++) view.setUint8(offset + i, s.charCodeAt(i));
        };

        writeString(0, 'RIFF');
        view.setUint32(4, 36 + dataSize, true);
        writeString(8, 'WAVE');
        writeString(12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true);
        view.setUint16(22, channels, true);
        view.setUint32(24, rate, true);
        view.setUint32(28, rate * blockAlign, true);
        view.setUint16(32, blockAlign, true);
        view.setUint16(34, 16, true);
        writeString(36, 'data');
        view.setUint32(40, dataSize, true);

        const data = Array.from({ length: channels }, (_, c) => buffer.getChannelData(c));
        let offset = 44;
        for (let i = 0; i < frames; i++) {
          for (let c = 0; c < channels; c++) {
            const s = Math.max(-1, Math.min(1, data[c][i]));
            view.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7fff, true);
            offset += 2;
          }
        }
        // Tile the first iteration across the rest of the data chunk.
        if (repeats > 1) {
          const bytes = new Uint8Array(view.buffer);
          const first = bytes.subarray(44, 44 + onceSize);
          for (let r = 1; r < repeats; r++) bytes.set(first, 44 + r * onceSize);
        }
        return new Blob([view], { type: 'audio/wav' });
      }

      /**
       * A silent WAV, used only to prime the <audio> element on the very first
       * Start press. iOS in particular only allows play() from a user gesture,
       * and by the time the real loop above finishes rendering that gesture has
       * expired — but once an element has played anything at all from directly
       * inside a click handler, later play() calls on that same element keep
       * working without a fresh gesture, even after its src is swapped out.
       */
      function silentWavUrl(seconds: number, rate = 44100): string {
        const dataSize = Math.ceil(rate * seconds) * 2;
        const view = new DataView(new ArrayBuffer(44 + dataSize));
        const writeString = (offset: number, s: string) => {
          for (let i = 0; i < s.length; i++) view.setUint8(offset + i, s.charCodeAt(i));
        };
        writeString(0, 'RIFF');
        view.setUint32(4, 36 + dataSize, true);
        writeString(8, 'WAVE');
        writeString(12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true);
        view.setUint16(22, 1, true);
        view.setUint32(24, rate, true);
        view.setUint32(28, rate * 2, true);
        view.setUint16(32, 2, true);
        view.setUint16(34, 16, true);
        writeString(36, 'data');
        view.setUint32(40, dataSize, true);
        // The rest of the buffer is already zero-filled — that is the silence.
        return URL.createObjectURL(new Blob([view], { type: 'audio/wav' }));
      }

      /**
       * How much audio to render before the file wraps. A native `loop` is not
       * guaranteed gapless: on phones (Safari especially) the decoder restarts
       * at the loop point and the beat after it arrives late, which is very
       * audible on a pattern where every beat sounds. So one file holds many
       * whole repetitions of the pattern and the seam only happens once per
       * this many seconds, not once per compás.
       */
      const RENDER_SECONDS = 30;

      /**
       * Render the current pattern and tempo once, then tile it to fill
       * RENDER_SECONDS in whole iterations. `seconds` is the length of ONE
       * iteration, which is what the playhead wraps on.
       */
      async function renderLoop(): Promise<{ url: string; seconds: number }> {
        const ideal = SLOTS * slotSeconds();
        const rate = 44100;
        const frames = Math.ceil(rate * ideal);
        const offline = new OfflineAudioContext(1, frames, rate);
        for (let i = 0; i < SLOTS; i++) {
          const t = i * slotSeconds();
          if (active[i]) click(offline, 'beat', t);
          else if (pulseInput.checked && i % SLOTS_PER_BEAT === 0) click(offline, 'pulse', t);
        }
        const rendered = await offline.startRendering();
        const repeats = Math.max(1, Math.ceil(RENDER_SECONDS / ideal));
        // The file's real period is a whole number of samples, so wrap on that.
        return { url: URL.createObjectURL(encodeWav(rendered, repeats)), seconds: frames / rate };
      }

      let loopSeconds = SLOTS * slotSeconds();
      let objectUrl: string | null = silentWavUrl(0.2);
      player.src = objectUrl;
      let raf = 0;
      let lit = -1;

      // Mobile browsers (Safari in particular) only update
      // `player.currentTime` in coarse steps, well behind the actual audio
      // output — reading it straight in a rAF loop makes the highlight visibly
      // trail the click. Between updates, extrapolate from performance.now()
      // instead, and only resync to currentTime when the browser actually
      // reports a new value.
      let syncedAudioTime = 0;
      let syncedAtPerf = 0;

      function estimatedAudioTime() {
        const reported = player.currentTime;
        const now = performance.now();
        if (reported !== syncedAudioTime) {
          syncedAudioTime = reported;
          syncedAtPerf = now;
        }
        return reported + (now - syncedAtPerf) / 1000;
      }

      function followPlayhead() {
        if (player.paused) return;
        const t = estimatedAudioTime() % loopSeconds;
        const slot = Math.min(SLOTS - 1, Math.floor(t / slotSeconds()));
        if (slot !== lit) {
          if (lit >= 0) bars[lit].classList.remove('is-now');
          bars[slot].classList.add('is-now');
          lit = slot;
        }
        raf = requestAnimationFrame(followPlayhead);
      }

      function setMediaSession(playing: boolean) {
        if (!('mediaSession' in navigator)) return;
        try {
          navigator.mediaSession.metadata = new MediaMetadata({
            title: currentName,
            artist: labels.artist,
          });
          navigator.mediaSession.playbackState = playing ? 'playing' : 'paused';
        } catch {
          // Media Session isn't available everywhere; playback itself doesn't need it.
        }
      }

      /** Rebuild the loop from the current pattern/tempo and start it playing. */
      async function refreshLoop() {
        const { url, seconds } = await renderLoop();
        const previous = objectUrl;
        objectUrl = url;
        loopSeconds = seconds;
        player.src = url;
        player.loop = true;
        // A fresh src resets currentTime to 0 — resync immediately so the
        // playhead doesn't extrapolate from the previous loop's timeline.
        syncedAudioTime = 0;
        syncedAtPerf = performance.now();
        await player.play();
        if (previous) URL.revokeObjectURL(previous);
      }

      async function start() {
        // Play whatever is currently loaded (the silent primer, first time
        // round) directly inside this click handler. The real loop is assigned
        // after an await in refreshLoop() below, too late on its own to count
        // as the user gesture some browsers require to allow playback.
        try {
          await player.play();
        } catch {
          // Some browsers still refuse this first attempt; refreshLoop() below
          // tries again once the real loop is ready.
        }
        await refreshLoop();
        playBtn.setAttribute('aria-pressed', 'true');
        playLabel.textContent = labels.stop;
        setMediaSession(true);
        raf = requestAnimationFrame(followPlayhead);
      }

      function stop() {
        player.pause();
        cancelAnimationFrame(raf);
        if (lit >= 0) bars[lit].classList.remove('is-now');
        lit = -1;
        playBtn.setAttribute('aria-pressed', 'false');
        playLabel.textContent = labels.start;
        setMediaSession(false);
      }

      /** If the loop is currently playing, rebuild it in place so an edit takes effect immediately. */
      function reloadIfPlaying() {
        if (!player.paused) refreshLoop();
      }

      // --- wiring -----------------------------------------------------------

      playBtn.addEventListener('click', () => {
        if (playBtn.getAttribute('aria-pressed') === 'true') stop();
        else start();
      });

      if ('mediaSession' in navigator) {
        navigator.mediaSession.setActionHandler('play', () => start());
        navigator.mediaSession.setActionHandler('pause', () => stop());
      }

      bars.forEach((b, i) => {
        b.addEventListener('click', () => {
          active[i] = !active[i];
          paint();
          // The grid no longer matches the chosen exercise.
          select.value = 'custom';
          currentName = labels.ownName;
          noteEl.textContent = labels.ownNote;
          reloadIfPlaying();
        });
      });

      select.addEventListener('change', () => {
        load(select.value);
        reloadIfPlaying();
      });

      resetBtn.addEventListener('click', () => {
        select.value = DEFAULT_ID;
        load(DEFAULT_ID);
        reloadIfPlaying();
      });

      bpmInput.addEventListener('input', () => {
        const bpm = Number(bpmInput.value);
        // Vals is quoted in compases per minute as often as in BPM, so show both.
        bpmOut.textContent = vals
          ? `${bpm} BPM · ${Math.round(bpm / 3)} ${labels.bars}`
          : `${bpm} BPM`;
      });
      // 'change' (fires on release), not 'input' (fires on every drag tick) —
      // re-rendering the loop on every pixel of a drag would be wasted work.
      bpmInput.addEventListener('change', () => reloadIfPlaying());

      pulseInput.addEventListener('change', () => reloadIfPlaying());

      document.querySelectorAll<HTMLButtonElement>('.rhythm-orchestra-btn').forEach((b) => {
        b.addEventListener('click', () => {
          bpmInput.value = b.dataset.bpm!;
          bpmInput.dispatchEvent(new Event('input'));
          reloadIfPlaying();
        });
      });

      select.value = DEFAULT_ID;
      load(DEFAULT_ID);
    }
  </script>
</BaseLayout>
